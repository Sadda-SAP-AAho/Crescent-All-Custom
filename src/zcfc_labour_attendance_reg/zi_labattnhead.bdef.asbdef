managed implementation in class zbp_i_labattnhead unique;
strict;
with draft;

define behavior for ZI_LABATTNHEAD //alias <alias_name>
persistent table zdt_labattnhead
draft table zdr_labattnhead
lock master
total etag Docnum
authorization master ( instance )
//etag master <field_name>

{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  field ( readonly : update, numbering : managed ) Id;
  field ( readonly ) Docnum, Plantname;

  create;
  update;
  delete;
  determination determinedocnum on save { create; }
  determination updateheader on modify { field Plantcode; }
  side effects { field Plantcode affects field Plantname; }
  association _Item { create; }

  validation checkcombination on save { create; update; }
  validation checkcategory on save { create; update; }

  mapping for zi_labattnhead
    {
      Fisyear    = Fisyear;
      Docnum     = Docnum;
      Keyid      = Keyid;
      Creon      = Creon;
      Creby      = Creby;
      Reportdate = Reportdate;
      Plantcode  = Plantcode;
      Plantname  = Plantname;
    }
}

define behavior for ZI_LABATTNITEM //alias <alias_name>
persistent table zdt_labattnitem
draft table zdr_labattnitem
lock dependent by _Head
authorization dependent by _Head
//etag master <field_name>

{
  field ( readonly : update, numbering : managed ) Item;
  field ( readonly ) Id;
  field ( readonly ) Contname, Deptname, Oprname;
  update;
  delete;
  determination updateitem on modify { field Contcode; field Deptcode; field Oprcode; }
  side effects { field Contcode affects field Contname; field Deptcode affects field Deptname; field Oprcode affects field Oprname; }

  association _Head { with draft; }

  mapping for zi_labattnitem
    {
      Contcode = Contcode;
      Contname = Contname;
      Deptcode = Deptcode;
      Deptname = Deptname;
      Category = Category;
      Oprcode  = Oprcode;
      Oprname  = Oprname;
      Noofhead = Noofhead;
    }
}