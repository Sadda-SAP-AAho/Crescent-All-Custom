projection;
strict;
use draft;
use side effects;

define behavior for ZC_GHEAD //alias <alias_name>
{
  use create;
  use update;
 // use delete;

  use action GatePassOut;
  //use action Cancel;
  use action Deleted;
  use action TPrint;
  //  use action WLFPL;
  //  use action Item;
  use action Create;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZC_GITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}