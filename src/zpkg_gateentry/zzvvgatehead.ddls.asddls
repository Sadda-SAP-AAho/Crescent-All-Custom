@ObjectModel.query.implementedBy: 'ABAP:ZCL_GATE_IMPL'
@EndUserText.label: 'Gate Header Print'
define custom entity ZZVVGATEHEAD
{
  key id                       : sysuuid_x16;
      challannumber            : xblnr1;
      challandate              : sydate;
      rrno                     : abap.char(10);
      rrdate                   : sydate;
      lrblno                   : abap.char(10);
      lbbldate                 : sydate;
      billofentryno            : abap.char(40);
      billofentrydate          : sydate;
      miningpermissionno       : abap.char(15);
      waybillno                : abap.char(20);
      miningchallantpno        : abap.char(30);
      plantgateno              : abap.char(10);
      plantweighbridgeno       : abap.char(10);
      shipmenttype             : abap.char(32);
      vehno                    : abap.char(12);
      containernumber          : abap.char(40);
      vesselname               : abap.char(30);
      rakeno                   : abap.char(30);
      raketripno               : abap.char(10);
      ernam                    : syuname;
      erdat                    : sydate;
      erzet                    : timn;
      gateentrydate            : sydate;
      gateentrytime            : timn;
      vendorcode               : lifnr;
      vendorname               : abap.char(80);
      customercode             : lifnr;
      customername             : name1_gp;
      drivername               : abap.char(64);
      drivercellno             : abap.char(10);
      dlno                     : abap.char(25);
      vehiclecheck             : abap.char(40);
      testcertificate          : abap.char(40);
      taxinvoice               : abap.char(40);
      transportercode          : lifnr;
      transportername          : name1_gp;
      invoice                  : abap.char(16);
      invoicedate              : sydate;
      remarks                  : abap.char(160);
      gatepass                 : abap.numc(10);
      gatepassdate             : sydate;
      purchasingdocumentnumber : abap.char(10);
      vehicleoutdate           : sydate;
      vehicleouttime           : timn;
      unloaddate               : sydate;
      unloadtime               : timn;
      gateout                  : abap_boolean;
      deleted                  : abap_boolean;
      cancel                   : abap_boolean;
      tprint                   : abap_boolean;
      miscnumber               : xblnr1;
      miscdate                 : sydate;
      currentyear              : gjahr;
      currentnumber            : abap.numc(8);
      bukrs                    : bukrs;
      plant                    : abap.char(4);
      type                     : abap.char(15);
      meins                    : meins;
      @Semantics.quantity.unitOfMeasure : 'meins'
      netwt                    : menge_d;
      @Semantics.quantity.unitOfMeasure : 'meins'
      tarwt                    : menge_d;
      @Semantics.quantity.unitOfMeasure : 'meins'
      grswt                    : menge_d;
      @Semantics.quantity.unitOfMeasure : 'meins'
      vendor_netwt             : menge_d;
      @Semantics.quantity.unitOfMeasure : 'meins'
      vendor_tarwt             : menge_d;
      @Semantics.quantity.unitOfMeasure : 'meins'
      vendor_grswt             : menge_d;
      deleteuser               : syuname;
      deletedate               : sydate;
      status                   : abap.char(20);
      criticality              : abap.int1;
      printr                   : abap_boolean;
      wlfpl                    : abap_boolean;
      item                     : abap_boolean;
      fromplace                : abap.char(80);
      toplace                  : abap.char(80);
      multiweight              : abap.char(20);
      noofweight               : abap.char(20);
      mpno                     : abap.char(20);
      tpno                     : abap.char(20);
      rgpgatepass              : abap.char(10);
      rgpdate                  : abap.dats;
      deliverynumber           : abap.char(10);
      sendername               : abap.char(30);
      Phonenumber              : abap.char( 16 );
      _item                    : association [1..*] to ZVGATEITEMPRINT on $projection.id = _item.Id;
}
