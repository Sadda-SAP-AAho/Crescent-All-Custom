managed with additional save implementation in class ZBP_I_SCROLLTYPEMAINTENAN_S unique;
strict;
with draft;
define behavior for ZI_ScrollTypeMaintenan_S alias ScrollTypeMainteAll
draft table ZDT_SCROTYP_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _ScrollTypeMaintenan { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_ScrollTypeMaintenan alias ScrollTypeMaintenan ##UNMAPPED_FIELD
persistent table ZDT_SCROTYPE_TMG
draft table ZDT_SCROTYPE__D
lock dependent by _ScrollTypeMainteAll
authorization dependent by _ScrollTypeMainteAll

{
  field ( mandatory : create )
   Type;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Type;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_SCROTYPE_TMG
  {
    Type = TYPE;
    Description = DESCRIPTION;
    Glaccount = GLACCOUNT;
  }

  association _ScrollTypeMainteAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}