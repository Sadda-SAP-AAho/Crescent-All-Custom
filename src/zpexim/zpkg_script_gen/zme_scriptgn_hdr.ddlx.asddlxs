@Metadata.layer: #CUSTOMER
@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'scriptdate', direction:  #DESC }],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'FD Header' }]
     }
@UI: { headerInfo: { title: { type: #STANDARD, label: 'Scrip Header', value: 'scriptno' } } }
annotate entity zc_scriptgn_HDR with
{
  @UI.facet:
  [
   { id : 'GeneralData', isSummary: true, label: 'Script Generation', position: 5, type: #COLLECTION },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 10, id: 'GeneralData1', label: 'Script Details'  },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData2', parentId: 'GeneralData', position: 25, id: 'GeneralData2', label: 'Creation Details'},
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData3', parentId: 'GeneralData', position: 30, id: 'GeneralData3', label: 'Changed Details' },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData4', parentId: 'GeneralData', position: 20, id: 'GeneralData4', label: 'Account Post Details' },

     { id: 'ScriptGen', label: 'Script Item Details',type: #LINEITEM_REFERENCE, position : 15, targetElement: '_Item' }

  ]
  @UI.hidden: true
  id;

  @UI.lineItem: [ { position: 10 } ]
  @UI.identification: [ { position: 10 } ]
  @UI.selectionField: [{ position: 10 }]
  @UI.fieldGroup: [ { position: 10,  qualifier: 'GeneralData1', importance: #HIGH } ]
  scriptno;

  @UI.lineItem: [ { position: 15 } ]
