  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [ { position: 20,  qualifier: 'GeneralData1', importance: #HIGH } ]
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'scrollno', name:'zf4_scroll_number' },
                                              distinctValues: true,
                                              useForValidation: true }]
  scrollno;
  @UI.hidden: true
  shippingbill;
  @UI.lineItem: [ { position: 30 } ]
  @UI.identification: [ { position: 30 } ]
  @UI.fieldGroup: [ { position: 30,  qualifier: 'GeneralData2', importance: #HIGH } ]

  status;
