projection;
strict;
use draft;
use side effects;

define behavior for zc_scriptgn_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;


  use association _Item { create; with draft; }
}

define behavior for zc_scriptgn_itm //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}