projection;
strict ;
use draft;
use side effects;

define behavior for zc_scriptsl_hdr alias head
{

  use create;
  use update;
  use delete;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action PrintScriptInv;

  use association _Item { create; with draft; }

}
define behavior for zc_scriptsl_itm alias item
{
  use update;
  use delete;

  use association _Head { with draft; }
}