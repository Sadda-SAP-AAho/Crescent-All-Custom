projection;
strict ( 1 );
use draft;

define behavior for ZC_INTCAL_HD //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZC_INTCAL_IT //alias <alias_name>
{
  use update;
  use delete;

  use association _Head;
}