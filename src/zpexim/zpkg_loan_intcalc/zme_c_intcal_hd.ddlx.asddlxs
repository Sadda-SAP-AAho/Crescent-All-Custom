                                 useForValidation: true
                            }]
  costcenter;

  @UI: {
  lineItem: [ { position: 130} ],
  identification: [{position: 130 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 100,importance: #HIGH }]
  }
  penalty;

  @UI: {
  lineItem: [ { position: 140} ],
  identification: [{position: 140 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 110,importance: #HIGH }]
  }
  penaltyfc;

  @UI: {
  lineItem: [ { position: 140} ],
  identification: [{position: 140 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 90,importance: #HIGH }]
  }
  ineterestref;

  @UI: {
  lineItem: [ { position: 150} ],
  identification: [{position: 150 }],
  fieldGroup: [{qualifier: 'GeneralData3',position: 10,importance: #HIGH }]
  }
  accdocno;

  @UI: {
  lineItem: [ { position: 160} ],
  identification: [{position: 160 }],
  fieldGroup: [{qualifier: 'GeneralData3',position: 30,importance: #HIGH }]
  }
  accdocyr;

  @UI: {
  lineItem: [ { position: 170} ],
  identification: [{position: 170 }],
  fieldGroup: [{qualifier: 'GeneralData3',position: 10,importance: #HIGH }]
  }
  fullcalc;

  @UI: {
  lineItem: [ { position: 170} ],
  identification: [{position: 170 }],
  fieldGroup: [{qualifier: 'GeneralData3',position: 10,importance: #HIGH }]
  }
  post;

  @UI.hidden : true
  local_last_changed_by;
  @UI.hidden : true
  local_last_changed_at;
  @UI.hidden : true
  last_changed_at;
}