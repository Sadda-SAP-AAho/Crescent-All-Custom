@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'documentdate', direction:  #DESC }],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'Interest Calc. - Header' }]
     }

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Cost Calc. ID', value: 'nameid' } } }

annotate entity ZC_INTCAL_HD with
{

  @UI.facet:
   [

   {
   id: 'GeneralData',
   isSummary: true,
   label: 'Loan Int. Calc.',
   position: 5,
   type: #COLLECTION
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'GeneralData1',
   parentId: 'GeneralData',
   label: 'Interest Calc. Information',
   position: 10,
   id: 'GeneralData1'
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'GeneralData2',
   parentId: 'GeneralData',
   label: 'Document Header Details',
   position: 30,
   id: 'GeneralData2'
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'GeneralData3',
   parentId: 'GeneralData',
   label: 'Posting Details',
   position:40,
   id: 'GeneralData3'
   },

   {
   id: 'Items',
   label: 'Items',
   type: #LINEITEM_REFERENCE,
   position: 10,
   targetElement: '_item'
   }

   ]

  @UI.hidden: true
  id;

  @UI: {
   lineItem: [ { position: 10} ],
   identification: [{position: 10 }],
   fieldGroup: [{qualifier: 'GeneralData1',position: 10,importance: #HIGH }]
  }
  nameid;

  @UI: {
   lineItem: [ { position: 20} ],
   identification: [{position: 20 }],
   fieldGroup: [{qualifier: 'GeneralData1',position: 20,importance: #HIGH }]
  }
  local_created_by;

  @UI: {
   lineItem: [ { position: 25} ],
   identification: [{position: 25 }],
   fieldGroup: [{qualifier: 'GeneralData1',position: 25,importance: #HIGH }]
  }
  local_created_at;

//  @UI: {
//   lineItem: [ { position: 30} ],
//   identification: [{position: 30 }],
//   selectionField: [{ position: 10 }],
//   fieldGroup: [{qualifier: 'GeneralData1',position: 30,importance: #HIGH }]
//  }
//
//  @Consumption.valueHelpDefinition:[{
//       entity: { element: 'TMonth', name: 'ZR_MONTH' },
//                            distinctValues: true,
//                            useForValidation: true }]
  @UI.hidden: true
  tmonth;

//  @UI: {
//  lineItem: [ { position: 40} ],
//  identification: [{position: 40 }],
//  selectionField: [{ position: 20 }],
//  fieldGroup: [{qualifier: 'GeneralData1',position: 40,importance: #HIGH }]
//  }
  @UI.hidden: true
  tyear;

  @UI: {
  lineItem: [ { position: 42} ],
  identification: [{position: 42 }],
  fieldGroup: [{qualifier: 'GeneralData1',position: 42,importance: #HIGH }]
  }
  startdate;

  @UI: {
  lineItem: [ { position: 44} ],
  identification: [{position: 44 }],
  fieldGroup: [{qualifier: 'GeneralData1',position: 44,importance: #HIGH }]
  }
  enddate;

  @UI.hidden: true
  loantype;

  @UI: {
  lineItem: [ { position: 44} ],
  identification: [{position: 44 }],
  fieldGroup: [{qualifier: 'GeneralData1',position: 44,importance: #HIGH }]
  }

  @Consumption.valueHelpDefinition: [{ entity:{ element: 'Loanacno', name:'ZI_PCRHDR' },
                                 distinctValues: true,
                                 useForValidation: true
                            }]
  loanacno;

  @UI.hidden: true
  bankkey;

  @UI: {
  lineItem: [ { position: 45} ],
  identification: [{position: 45 }],
  fieldGroup: [{qualifier: 'GeneralData1',position: 45,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition:[{
       entity: { element: 'BankName', name: 'ZCDS_BANKF4' },
                            distinctValues: true,
                            useForValidation: true }]
  bankname;

  @UI: {
  lineItem: [ { position: 50} ],
  identification: [{position: 50 }],
  fieldGroup: [{qualifier: 'GeneralData1',position: 50,importance: #HIGH }]
  }
  statusdesc;

  @UI: {
  lineItem: [ { position: 60} ],
  identification: [{position: 60 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 10,importance: #HIGH }]
  }
  documentdate;

  @UI: {
  lineItem: [ { position: 70} ],
  identification: [{position: 70 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 20,importance: #HIGH }]
  }
  postingdate;

  @UI: {
  lineItem: [ { position: 80} ],
  identification: [{position: 80 }],
  fieldGroup: [{qualifier: 'GeneralData2',position: 30,importance: #HIGH }]
  }
  headertext;

  @UI: {
  lineItem: [ { position: 90} ],
