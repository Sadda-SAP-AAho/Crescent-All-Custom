projection;
strict;
use draft;
use side effects;

define behavior for ZC_FINALPACK_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Cancel;
  use action Prnt;
  use action UPDATE;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
   use association _Item1 { create; with draft; }
}

define behavior for ZC_FINALPACK_ITM //alias <alias_name>
{
  use update;
  use delete;

 // use action Copy;

  use association _Head { with draft; }
}

define behavior for ZC_FPLPRINTFIELD //alias <alias_name>
{
  use update;
//  use delete;

 // use action Copy;

  use association _Head { with draft; }
}