managed implementation in class zbp_i_packlist_hdr unique;
strict;
with draft;
define behavior for ZI_PACKLIST_HDR//alias <alias_name>
persistent table zdt_packlist_hdr
draft table zdr_packlist_hdr
with additional save
lock master
total etag Createdat
authorization master ( instance )
//etag master <field_name>
{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }
  field ( readonly : update, numbering : managed ) Id;
  field ( mandatory : create, readonly : update ) Delivery;
  field ( readonly ) Revision, Packinglist, Salesorg, Plant, Createdby, Createdon,
  Createdat, Changeddby, Changedon, Changedat, Status;

  create;
  update ( features : instance );
  delete ( features : instance );

  action ( features : instance ) Cancel result [1] $self;
  //  action ( features : instance ) Prnt   result [1] $self;
  action ( features : instance ) Print result [1] $self;
  action ( features : instance ) Domdprint result [1] $self;
  action ( features : instance ) Domprinthsn result [1] $self;
  action ( features : instance ) Xporprinthsn result [1] $self;

  determination determinepackinglist on save { create; }
  determination deliverydetails on modify { field Delivery; }
  validation checkdel on save { create; }

  association _Item { create ( features : instance ); with draft; }

  mapping for zi_packlist_hdr
    {
      Packinglist  = Packinglist;
      Delivery     = Delivery;
      Salesorg     = Salesorg;
      Plant        = Plant;
      Createdby    = Createdby;
      Createdon    = Createdon;
      Createdat    = Createdat;
      Changeddby   = Changeddby;
      Changedon    = Changedon;
      Changedat    = Changedat;
      Canind       = Canind;
      Cancelby     = Cancelby;
      Dprint       = Dprint;
      Cancelon     = Cancelon;
      Status       = Status;
      Domprint     = Domprint;
      Zstatus      = Zstatus;
      Contactp     = Contactp;
      Contactn     = Contactn;
      Pkgtyp       = Pkgtyp;
      Customercode = Customercode;
      Customername = Customername;
      Remarks      = Remarks;
    }
}

define behavior for ZI_PACKLIST_ITM //alias <alias_name>
persistent table zdt_packlist_itm
draft table zdr_packlist_itm
lock dependent by _Head
authorization dependent by _Head
//etag master Matnr
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly : update, numbering : managed ) Item;
  field ( readonly ) Id, Packinglist, Delivery, Posnr, Plant,maktx, Matnr,  Meins, Mateachpkg,
  Eachnetwt, Eachgrowt, Netwt, Growt, Packmat, Wtunit, Matnetwt;

  field ( features : instance ) Priority, Packqty, Qty, Packmattyp, Packmatnwt;

  action ( features : instance ) Copy result [1] $self;

  determination updateval on modify { field Priority; field packqty; field qty; field Packmatnwt; }
  determination updatedate on save { field Priority; field packqty; field qty; field Packmatnwt; }
  //  determination calcqty on modify { field Packqty; }
  side effects
  {
    field Packqty affects field Netwt, field Growt, field Eachnetwt, field Eachgrowt, entity _Head;
    field Priority affects field Netwt, field Growt, field Eachnetwt, field Eachgrowt, entity _Head;
    field Qty affects field Netwt, field Growt, field Eachnetwt, field Eachgrowt, entity _Head;
    field Packmatnwt affects field Netwt, field Growt, field Eachnetwt, field Eachgrowt, entity _Head;
    action Copy affects entity _Head;
  }

  association _Head { with draft; }

  mapping for zi_packlist_itm
    {
      Packinglist = Packinglist;
      Delivery    = Delivery;
      Posnr       = Posnr;
      Plant       = Plant;
      Matnr       = Matnr;
      Maktx       = Maktx;
      Meins       = Meins;
      Qty         = Qty;
      Packqty     = Packqty;
      Priority    = Priority;
      Packmat     = Packmat;
      Packmatnwt  = Packmatnwt;
      Matnetwt    = Matnetwt;
      Eachnetwt   = Eachnetwt;
      Eachgrowt   = Eachgrowt;
      Netwt       = Netwt;
      Growt       = Growt;
      Copy        = copy;
      Wtunit      = Wtunit;
      Packmattyp  = Packmattyp;
      Mateachpkg  = Mateachpkg;
    }
}