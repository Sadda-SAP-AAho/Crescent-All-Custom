managed with additional save implementation in class ZBP_I_PODMASTERTABLE_S unique;
strict;
with draft;
define behavior for ZI_PodMasterTable_S alias PodMasterTableAll
draft table ZDT_MPOD_TM_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _PodMasterTable { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_PodMasterTable alias PodMasterTable ##UNMAPPED_FIELD
persistent table ZDT_MPOD_TMG
draft table ZDT_MPOD_TMG_D
lock dependent by _PodMasterTableAll
authorization dependent by _PodMasterTableAll

{
  field ( mandatory : create )
   Podcode,
   Contsize,
   Gotrackcode;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Podcode,
   Contsize,
   Gotrackcode;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_MPOD_TMG
  {
    Podcode = PODCODE;
    Contsize = CONTSIZE;
    Gotrackcode = GOTRACKCODE;
    Podcodename = PODCODENAME;
    Transitdays = TRANSITDAYS;
    Grossweight = GROSSWEIGHT;
    Netweight = NETWEIGHT;
  }

  association _PodMasterTableAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}