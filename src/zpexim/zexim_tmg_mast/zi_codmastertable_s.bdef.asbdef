managed with additional save implementation in class ZBP_I_CODMASTERTABLE_S unique;
strict;
with draft;
define behavior for ZI_CodMasterTable_S alias CodMasterTableAll
draft table ZDT_MCOD_TM_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _CodMasterTable { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_CodMasterTable alias CodMasterTable ##UNMAPPED_FIELD
persistent table ZDT_MCOD_TMG
draft table ZDT_MCOD_TMG_D
lock dependent by _CodMasterTableAll
authorization dependent by _CodMasterTableAll

{
  field ( mandatory : create )
   Codcode;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Codcode;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_MCOD_TMG
  {
    Codcode = CODCODE;
    Codcodenam = CODCODENAM;
    Specialrequirements = SPECIALREQUIREMENTS;
  }

  association _CodMasterTableAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}