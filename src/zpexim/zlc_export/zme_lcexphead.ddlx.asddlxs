  @UI: { lineItem: [{ position: 14 }],
       identification: [{ position: 14 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 14, importance: #HIGH }] }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'CompanyCode', name:'I_CompanyCode' },
                                distinctValues: true,
                                useForValidation: true }]
  Companycode;
  @UI: { lineItem: [{ position: 15 }],
       identification: [{ position: 15 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 15, importance: #HIGH }] }
  @Consumption.valueHelpDefinition:[
                              { entity: { element: 'SalesOrganization', name: 'ZR_SALESORG_F4' } ,
                               distinctValues: true,
  additionalBinding: [{ localElement: 'Companyname',element: 'YY1_SD_SORD_Company_Na_SDH',usage: #FILTER_AND_RESULT }]
                     }]
