@Metadata.layer: #CUSTOMER

@UI: { presentationVariant: [{ sortOrder: [{ by: 'SO', direction:  #DESC }],
                               visualizations: [{ type: #AS_LINEITEM }],
                               text: 'LC Export Dashboard' }] }
@UI: { headerInfo: { title: { type: #STANDARD, label: 'Export LC ', value: 'Lc_Appl' } } }
annotate view zc_lcexphead with
{
  @UI.facet:
   [{ id: 'GeneralData', isSummary: true, label: 'Export LC', type: #COLLECTION },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 10, label: 'LC details', id: 'GeneralData1' },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData2', parentId: 'GeneralData', position: 15, label: 'Header Details', id: 'GeneralData2' },
    { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData3', parentId: 'GeneralData', position: 20, label: 'Amount', id: 'GeneralData3' },

    { id: 'Lcbankdlts', label: 'Bank Details',              type: #LINEITEM_REFERENCE, position : 55, targetElement: '_item1' },
    { id: 'Lcexpitm',   label: 'Attach Delivery Document',  type: #LINEITEM_REFERENCE, position : 60, targetElement: '_item2' }]
  //    { id: 'Lcbankref', label: 'Bank Reference', type: #LINEITEM_REFERENCE, position : 65, targetElement: '_item3' } ]

  @UI.hidden: true
  Id;
  @UI: { lineItem: [{ position: 5 }],
       identification: [{ position: 5 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 5, importance: #HIGH }] }
