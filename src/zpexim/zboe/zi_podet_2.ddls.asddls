@EndUserText.label: 'PO Details'
define view ZI_PODet_2

  as select from I_PurchaseOrderAPI01     as a

    inner join   I_PurchaseOrderItemAPI01 as b on b.PurchaseOrder = a.PurchaseOrder

    inner join   I_Supplier               as c on c.Supplier = a.Supplier

