  b.PurgItemIsBlockedForDelivery,
  b.SupplierConfirmationControlKey,
  b.PriceIsToBePrinted,
  b.AccountAssignmentCategory,
  b.PurchasingInfoRecord,
  b.NetAmount,
  b.GrossAmount,
  b.EffectiveAmount,
  b.Subtotal1Amount,
  b.Subtotal2Amount,
  b.Subtotal3Amount,
  b.Subtotal4Amount,
  b.Subtotal5Amount,
