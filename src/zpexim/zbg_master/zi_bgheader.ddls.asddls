@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Root Entity View for BG Head'
@ObjectModel.representativeKey: 'id'
@ObjectModel.usageType.dataClass: #TRANSACTIONAL
@ObjectModel.usageType.serviceQuality: #A
@ObjectModel.usageType.sizeCategory: #L
define root view entity ZI_BGHEADER
  as select from zbg_header
  composition [0..*] of zi_ATTACHPO   as _bgattachpo
  composition [0..*] of zi_Bgfdassign as _bgfdassign
{
  key zbg_header.id                 as Id,
      zbg_header.zeximbgrefno       as Zeximbgrefno,
      zbg_header.version            as Version,
      zbg_header.bukrs              as Bukrs,
      zbg_header.butxt              as Butxt,
      zbg_header.street             as Street,
      zbg_header.city               as City,
      zbg_header.state              as State,
      zbg_header.postcode           as Postcode,
      zbg_header.country            as Country,
      zbg_header.bgstat             as Bgstat,
      zbg_header.bgcharacter        as Bgcharacter,
      zbg_header.hbkid              as Hbkid,
      zbg_header.hktid              as Hktid,
      zbg_header.bankl              as Bankl,
      zbg_header.bgbenfname         as Bgbenfname,
      zbg_header.bankaddr           as Bankaddr,
      zbg_header.brnch              as Brnch,
      zbg_header.bezei              as Bezei,
      zbg_header.land1              as Land1,
      zbg_header.lbankpostcode      as Lbankpostcode,
      zbg_header.swift              as Swift,
      zbg_header.vendor             as Vendor,
      zbg_header.vendorname         as Vendorname,
      zbg_header.vendorname2        as Vendorname2,
      zbg_header.bgreqdt            as Bgreqdt,
      zbg_header.bgeffdt            as Bgeffdt,
      zbg_header.bgexpdt            as Bgexpdt,
      zbg_header.bgclaimexpdt       as Bgclaimexpdt,
      zbg_header.bgtype             as Bgtype,
      zbg_header.bgcatag            as Bgcatag,
      zbg_header.bgamt              as Bgamt,
      zbg_header.bgtenure           as Bgtenure,
      zbg_header.bgtenureunit       as Bgtenureunit,
      zbg_header.bgbenefcode        as Bgbenefcode,
      zbg_header.bgbenefname        as Bgbenefname,
      zbg_header.bgaddress1         as Bgaddress1,
      zbg_header.bgaddress2         as Bgaddress2,
      zbg_header.bgcountry          as Bgcountry,
      zbg_header.bgstate            as Bgstate,
      zbg_header.bgcity             as Bgcity,
      zbg_header.bgpostalcode       as Bgpostalcode,
      zbg_header.bgpurpose          as Bgpurpose,
      zbg_header.bgexchangerate     as Bgexchangerate,
      zbg_header.bgamount           as Bgamount,
      zbg_header.bgcreator          as Bgcreator,
      zbg_header.bgcreditdays       as Bgcreditdays,
      zbg_header.chargesrate        as Chargesrate,
      zbg_header.waers              as Waers,
      zbg_header.bcopenchrgs        as Bcopenchrgs,
      zbg_header.bankbcopenchrgs    as Bankbcopenchrgs,
      zbg_header.bankminchrgs       as Bankminchrgs,
      zbg_header.nontaxamt          as Nontaxamt,
      zbg_header.stampcharges       as Stampcharges,
      zbg_header.pntcharges         as Pntcharges,
      zbg_header.taxcode            as Taxcode,
      zbg_header.cgst               as Cgst,
      zbg_header.sgst               as Sgst,
      zbg_header.igst               as Igst,
      zbg_header.totalchrgs         as Totalchrgs,
      zbg_header.bankremarks        as Bankremarks,
      zbg_header.busplc             as Busplc,
      zbg_header.seccode            as Seccode,
      zbg_header.bgammendcharges    as Bgammendcharges,
      zbg_header.bgtendate          as Bgtendate,
      zbg_header.shiftcharges       as Shiftcharges,
      zbg_header.shiftdate          as Shiftdate,
      zbg_header.netbgamount        as Netbgamount,
      zbg_header.bgcleanamount      as Bgcleanamount,
      zbg_header.fdamountassigned   as Fdamountassigned,
      zbg_header.bgcleanassigned    as Bgcleanassigned,
      zbg_header.locallastchangedat as Locallastchangedat,
      zbg_header.amendment as Amendment, 
      zbg_header.setout as Setout,
      zbg_header.status           as Status,
       case  when status = 'Created' then '2'
            when status = 'Completed' 
            then '3'
            else '1'
            end    as Criticality,
      _bgattachpo,
      _bgfdassign
}
