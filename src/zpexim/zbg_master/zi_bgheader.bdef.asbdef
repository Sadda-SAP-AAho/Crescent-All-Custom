define behavior for zi_ATTACHPO //alias <alias_name>
persistent table zdt_bgattachpo
draft table zdr_bgattachpo
lock dependent by _head
authorization dependent by _head
etag master locallastchangedat
{
  field ( readonly, numbering : managed ) Item3;
  update;
  delete;
  field ( readonly ) Id;
  association _head;
  mapping for zi_attachpo
    {
      zeximbgrefno = Zeximbgrefno;
      version      = version;
      ebeln        = ebeln;
      waers        = waers;
      netwr        = netwr;
      //  @Semantics.amount.currencyCode : 'zdt_bgattachpo.waers'
      //  availamount        : abap.curr(13,2);
      //  @Semantics.amount.currencyCode : 'zdt_bgattachpo.waers'
