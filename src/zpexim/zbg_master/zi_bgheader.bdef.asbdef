      //  @Semantics.amount.currencyCode : 'zdt_bgattachpo.waers'
      //  applamtothlc       : abap.curr(13,2);
      //  @Semantics.amount.currencyCode : 'zdt_bgattachpo.waers'
      //  amountlevel        : abap.curr(13,2);
      //  cancel             : abap.char(1);
      //  meins              : meins;
      //  @Semantics.quantity.unitOfMeasure : 'zdt_bgattachpo.meins'
      //  applqty            : menge_d;
      //  locallastchangedat : timestampl;
    }
}

define behavior for zi_Bgfdassign //alias <alias_name>
persistent table zdt_bgfdassign
draft table zdr_bgfdassign
lock dependent by _head
authorization dependent by _head
etag master locallastchangedat
{
  field ( readonly, numbering : managed ) Item;
  update;
  delete;
  field ( readonly ) Id;
  association _head;
}