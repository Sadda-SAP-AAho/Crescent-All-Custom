managed implementation in class zbp_i_bgheader unique;
strict ( 1 );
with draft;

define behavior for ZI_BGHEADER alias head
persistent table zbg_header
draft table zdr_bgheader
lock master
total etag locallastchangedat
authorization master ( instance )
with additional save
//etag master <field_name>
{
  create;
  update ( features : instance );
  delete;
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  field ( readonly, numbering : managed ) Id;
  field ( readonly ) Zeximbgrefno, Version, Status;
  //  field ( readonly ) Country;
  //  field ( readonly ) City ;
  field ( mandatory : create, readonly : update ) Bukrs;
  factory action ( features : instance ) Amendment [1];
  action ( features : instance ) SetOut result [1] $self;
  determination determainebgamt on modify { field Hbkid; }
  determination determinebgrefno on save { create; }
  association _bgattachpo { create; }
  association _bgfdassign { create; }

  mapping for zbg_header
    {
      id               = id;
      zeximbgrefno     = Zeximbgrefno;
      version          = Version;
      bukrs            = bukrs;
      butxt            = butxt;
      street           = street;
      city             = city;
      Country          = Country;
      //  state              : abap.char(20);
      //  postcode           : abap.char(10);
      //  country            : abap.char(15);
      //  bgstat             : abap.char(1);
      //  bgcharacter        : abap.char(2);
      hbkid            = HBKID;
      HKTID            = HKTID;
      BANKL            = BANKL;
      bgbenfname       = Bgbenefname;
      //  bankaddr           : abap.char(30);
      //  brnch              : abap.char(40);
      //  bezei              : abap.char(20);
      //  land1              : abap.char(15);
      //  lbankpostcode      : abap.char(10);
      swift            = swift;
      //  vendor             : abap.char(10);
      //  vendorname         : abap.char(35);
      //  vendorname2        : abap.char(35);
      //  bgreqdt            : abap.dats;
      //  bgeffdt            : abap.dats;
      //  bgexpdt            : abap.dats;
      //  bgclaimexpdt       : abap.dats;
      //  bgtype             : abap.char(20);
      //  bgcatag            : abap.char(40);
      //  bgamt              : abap.char(15);
      //  bgtenure           : abap.char(8);
      //  bgtenureunit       : abap.char(10);
      //  bgbenefcode        : abap.char(10);
      //  bgbenefname        : abap.char(40);
      //  bgaddress1         : abap.char(60);
      //  bgaddress2         : abap.char(60);
      //  bgcountry          : abap.char(20);
      //  bgstate            : abap.char(20);
      //  bgcity             : abap.char(30);
      //  bgpostalcode       : abap.char(15);
      //  bgpurpose          : abap.char(50);
      //  bgexchangerate     : abap.char(5);
      //  bgamount           : abap.char(15);
      //  bgcreator          : abap.char(13);
      //  bgcreditdays       : abap.char(10);
      //  chargesrate        : abap.dec(13,3);
      //  waers              : abap.cuky;
      //  @Semantics.amount.currencyCode : 'zdr_bgheader.waers'
      //  bcopenchrgs        : abap.curr(15,2);
      //  @Semantics.amount.currencyCode : 'zdr_bgheader.waers'
      //  bankbcopenchrgs    : abap.curr(15,2);
