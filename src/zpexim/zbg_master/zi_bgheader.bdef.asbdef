      //  nontaxamt          : abap.curr(15,2);
      //  @Semantics.amount.currencyCode : 'zdr_bgheader.waers'
      //  stampcharges       : abap.curr(15,2);
      //  @Semantics.amount.currencyCode : 'zdr_bgheader.waers'
      //  pntcharges         : abap.curr(15,2);
      //  taxcode            : mwskz;
