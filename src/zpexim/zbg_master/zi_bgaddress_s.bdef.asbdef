managed with additional save implementation in class ZBP_I_BGADDRESS_S unique;
strict;
with draft;
define behavior for ZI_BgAddress_S alias BgAddressAll
draft table ZDB_BGADDRE_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _BgAddress { create ( features : instance ); with draft; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_BgAddress alias BgAddress ##UNMAPPED_FIELD
persistent table ZDB_BGADDRESS
draft table ZDB_BGADDRESS_D
lock dependent by _BgAddressAll
authorization dependent by _BgAddressAll

{
  field ( mandatory : create )
   Bukrs;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Bukrs;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDB_BGADDRESS
  {
    Bukrs = BUKRS;
    Street = STREET;
    City = CITY;
    State = STATE;
    Postcode = POSTCODE;
    Country = COUNTRY;
  }

  association _BgAddressAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}