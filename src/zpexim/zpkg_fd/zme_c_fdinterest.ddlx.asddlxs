@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'enddate', direction:  #DESC }],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'Interest Entries' }]
     }

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Interest Ref', value: 'referenceno' } } }
annotate entity ZC_FDINTEREST with
{

  @UI.facet: [
  {
  id: 'GeneralI',
  isSummary: true,
  label: 'Interest Entry',
  type: #COLLECTION,
  purpose: #STANDARD
  },

  {
  type: #FIELDGROUP_REFERENCE,
  targetQualifier: 'GeneralData1',
  parentId: 'GeneralI',
  label: 'Interest Details',
  position: 10,
  id: 'GeneralData1'
  },

  {
  type: #FIELDGROUP_REFERENCE,
  targetQualifier: 'GeneralData2',
  parentId: 'GeneralI',
  label: 'Figures',
  position: 20,
  id: 'GeneralData2'
  }
  ]

  @UI.hidden : true
  id;
  @UI.hidden : true
  item;

  @UI: {
     lineItem: [ { position: 10} ],
     identification: [{position: 10 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 10,importance: #HIGH }]
  }
  referenceno;

  @UI: {
     lineItem: [ { position: 20} ],
     identification: [{position: 20 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 20,importance: #HIGH }]
  }
  startdate;

  @UI: {
     lineItem: [ { position: 30} ],
     identification: [{position: 30 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 30,importance: #HIGH }]
  }
  enddate;

  @UI: {
     lineItem: [ { position: 40} ],
     identification: [{position: 40 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 40,importance: #HIGH }]
  }
  documentdate;

  @UI: {
     lineItem: [ { position: 50} ],
     identification: [{position: 50 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 50,importance: #HIGH }]
  }
  postingdate;

  @UI: {
     lineItem: [ { position: 60} ],
     identification: [{position: 60 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 60,importance: #HIGH }]
  }
  text;

  @UI: {
     lineItem: [ { position: 70} ],
     identification: [{position: 70 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 70,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'GLAccount', name:'ZI_NORMGL' },
                                 distinctValues: true,
                                 useForValidation: true
                            }]
  interestgl;

  @UI: {
     lineItem: [ { position: 80} ],
     identification: [{position: 80 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 80,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'GLAccount', name:'ZI_BANKGL' },
                                   distinctValues: true,
                                   useForValidation: true
                              }]
  bankgl;

  @UI: {
     lineItem: [ { position: 90} ],
     identification: [{position: 90 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 90,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'HouseBank', name:'I_HouseBankAccountLinkage' },
                                 distinctValues: true,
                                 useForValidation: true
                            }]
  housebankid;

  @UI: {
     lineItem: [ { position: 100} ],
     identification: [{position: 100 }],
     fieldGroup: [{qualifier: 'GeneralData1',position: 100,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'HouseBankAccount', name:'I_HouseBankAccountLinkage' },
                               distinctValues: true,
                               useForValidation: true,
                               additionalBinding: [{ localElement: 'housebankid',element: 'HouseBank',usage:#FILTER }]
                          }]
  accountid;


  //Figures
  @UI: {
     lineItem: [ { position: 110} ],
     identification: [{position: 110 }],
     fieldGroup: [{qualifier: 'GeneralData2',position: 10,importance: #HIGH }]
  }
  amount;

  @UI: {
     lineItem: [ { position: 110} ],
     identification: [{position: 110 }],
     fieldGroup: [{qualifier: 'GeneralData2',position: 15,importance: #HIGH }]
  }
  tdsamount;

  @UI: {
     lineItem: [ { position: 110} ],
     identification: [{position: 110 }],
     fieldGroup: [{qualifier: 'GeneralData2',position: 18,importance: #HIGH }]
  }
  @Consumption.valueHelpDefinition: [{ entity:{ element: 'GLAccount', name:'ZI_NORMGL' },
                                 distinctValues: true,
                                 useForValidation: true
                            }]
  tdsgl;


  @UI: {
   lineItem: [ { position: 120} ],
   identification: [{position: 120 }],
   fieldGroup: [{qualifier: 'GeneralData2',position: 30,importance: #HIGH }]
  }
  transactionno;

  @UI: {
   lineItem: [ { position: 120} ],
   identification: [{position: 120 }],
   fieldGroup: [{qualifier: 'GeneralData2',position: 40,importance: #HIGH }]
  }
  transactiondate;

}