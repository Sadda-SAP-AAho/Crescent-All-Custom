@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Sales Regiester'
@Metadata.ignorePropagatedAnnotations: true
define root view entity ZCDS_SALESREGISTER
  as select from ZCDS_SALES_TMPFINAL
{
  key     GstInvoice,
  key     BillingDocumentItem,
  key     SalesOrderItem,
  key     CommercialInvNum,
  key     LedgerName,
          GSTInNo,
          PANNo, //Added by SP on 16.06.25
          SalesOrg,
          GstInvDate,
          ExchangeRate,
          InvoiceType,
          CommInvDate,
          BPCode,
          ShipmentLocation,
          SalesOrderNumber,
          OutboundDeliveryNo,
          SalesOrderDate,
          SaleNoteRef,
          ContaionerName,
          BPName,
          StateName,
          SalesEmpName,
          Currency,
          ItemDescription,
          UOM,
          Qty,
          unitWeight,
          //    @Semantics.quantity.unitOfMeasure: 'Uom'
          //    case eachgrowt
          //    when 0 then cast( NetWeight as abap.dec(13,3))
          //    else
          //    cast( ( NetWeight  +  eachgrowt )  as abap.dec(13,3) ) end as   GrossWeight,
          eachgrowt                         as GrossWeight,
          HSNCODE,
          TransactionCurrency,
          ValueInDC,
          ValueInLC,
          ValueInDcComm,
          ValueInLCom,
          DISC,
          ExportFreight,
          IGSTAmount,
          CGSTAmount,
          SGSTAmount,
          TCSAmount, //Added by Sp on 16.06.25
          PayTerms,
          StuffingDate,
          PortOfLoading,
          FinalDestination,
          ContainerSize,
          ShippingLine,
          ShippingType,
          VesselName,
          BLNo,
          BLDate,
          DocumentSentDate,
          DocumentPresentDate,
          AWBNo,
          ISFSentDate,
          EBRCNo,
          EBRCDate,
          ProfitCenter,
          LCNo,
          LCDate,
          LCIssuBank,
          IRNNo,
          EWAYBILLNo,
          ShipBill,
          ShipBillDate,
          DisInDC,
          DisInLC,
          EXInsurance,
          FInsuranceINDc,
          PortOfDischarge,
          Container,
          Material,
          MaterialGrp,
          WeightUnit,
          NetWeight,
          CustomerPo,
          CustomerPoDate,
          CustomerPOLineNo,
          BillingDocDate,
          wtunit,
          @Semantics.quantity.unitOfMeasure : 'wtunit'
          eachgrowt,
          CountOfDest,
          GLAccount,
          GLAccountName,
          ( FInsuranceINDc * ExchangeRate ) as FInsuranceINLC,
          DocumentReferenceID,
          CommInvRef,
          salesperson,
