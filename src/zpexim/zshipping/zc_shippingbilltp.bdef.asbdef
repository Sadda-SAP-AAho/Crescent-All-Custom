projection;
strict ;
use draft;
use side effects;

define behavior for ZC_ShippingBillTP //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action Cancel;

  use association _ShippingBillItemLIC { create; with draft; }
  use association _ShippingBillItem { create; with draft; }
}

define behavior for ZC_ShippingBillItemTP //alias <alias_name>
{
  use update;
  use delete;

  use association _ShippingBill;
}

define behavior for ZC_ShippingBillLICTP //alias <alias_name>
{
  use update;
  use delete;

  use association _ShippingBill;
}