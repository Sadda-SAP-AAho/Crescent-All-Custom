projection;
strict;
use draft;

define behavior for ZC_BRC_HEAD //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action uploadExcelData;
  use action valid;
  use action upd;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for ZC_BRC //alias <alias_name>
{
  use update;
  use delete;

  use association _BrcHead;
}