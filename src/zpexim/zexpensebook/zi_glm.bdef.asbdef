managed implementation in class zbp_i_glm unique;
strict ( 1 );
with draft;

define behavior for ZI_GLM //alias <alias_name>
persistent table zdt_expexpbook
draft table zdr_expexpbook
lock master total etag Glc1
authorization master ( instance )
//etag master <field_name>
{
  create;
  update;
  delete;
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  field ( readonly )   Psc, Gla, Glc1;
  field ( mandatory : create ) Exptyp, Descr, Glc2;

  mapping for zi_glm
  {
    Descr  = Descr;
    Gla    = Gla;
    Psc    = Psc;
    Glc1   = Glc1;
    Glc2   = Glc2;
  }
}