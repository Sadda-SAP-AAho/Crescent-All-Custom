managed with additional save implementation in class ZBP_I_COSTPROFITCENTERTMG_S unique;
strict;
with draft;
define behavior for ZI_CostProfitCenterTmg_S alias CostProfitCenterAll
draft table ZDT_EXP_COS_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _CostProfitCenterTmg { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_CostProfitCenterTmg alias CostProfitCenterTmg ##UNMAPPED_FIELD
persistent table ZDT_EXP_COSTC
draft table ZDT_EXP_COSTC_D
lock dependent by _CostProfitCenterAll
authorization dependent by _CostProfitCenterAll

{
  field ( mandatory : create )
   Profitcenter,
   Costcenter;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Profitcenter,
   Costcenter;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_EXP_COSTC
  {
    Profitcenter = PROFITCENTER;
    Costcenter = COSTCENTER;
  }

  association _CostProfitCenterAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}