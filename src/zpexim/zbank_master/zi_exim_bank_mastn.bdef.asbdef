managed implementation in class zbp_i_exim_bank_mastn unique;
strict ( 2 );
with draft;

define behavior for ZI_EXIM_BANK_MASTN //alias <alias_name>
persistent table zexim_bank_mastn
draft table zdr_bank_mastn
lock master
total etag locallastchangedat
authorization master ( global )
//etag master <field_name>
{
  create;
  update;
  delete;

  field ( mandatory : create, readonly : update ) Bukrs, Zland1, ZifscCode;//, Zswift;

  draft action edit;
  draft action Activate;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  mapping for zi_exim_bank_mastn
    {
      Zland1    = zland1;
      ZaccNo    = zaccno;
      ZadCode   = zadcode;
      Zaddress  = zaddress;
      Zaddress1 = zaddress1;
      Zaddress2 = zaddress2;
      Zaddress3 = zaddress3;
      Zbank     = zbank;
      Zbranch   = zbranch;
      ZifscCode = zifsccode;
      Zstate    = zstate;
      Zswift    = zswift;
      zbankgl   = zbankgl;
      zincgl    = zincgl;
      zoutgl    = zoutgl;
      zvendor   = zvendor;
    }
}