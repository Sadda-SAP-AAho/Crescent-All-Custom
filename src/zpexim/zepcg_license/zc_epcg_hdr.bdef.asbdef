projection;
strict;
use draft;
use side effects;

define behavior for ZC_EPCG_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for ZC_EPCG_ITM //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}