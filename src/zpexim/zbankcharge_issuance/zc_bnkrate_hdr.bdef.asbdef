projection;
strict;
use draft;
use side effects;
define behavior for ZC_BNKRATE_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; with draft; }
  use association _item1 { create; with draft; }
  use association _item2 { create; with draft; }
}

define behavior for ZC_BNKRATEBG //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}

define behavior for ZC_BNKRATEEXP //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}

define behavior for ZC_BNKRATEIMP //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}