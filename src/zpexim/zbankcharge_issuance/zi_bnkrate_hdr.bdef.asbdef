lock master
total etag Bankkey
authorization master ( instance )
//etag master <field_name>
{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  field ( mandatory ) Bankname, Accountid;
  field ( readonly : update, numbering : managed ) Id;
  field ( features : instance ) Bankkey, Waers, Bankname, Accountid, Housebnkid;

  create;
  update ( features : instance );
  delete ( features : instance );

  validation checkbank on save { create; }

  association _item { create ( features : instance ); with draft; }
  association _item1 { create ( features : instance ); with draft; }
  association _item2 { create ( features : instance ); with draft; }

  mapping for zi_bnkrate_hdr
    {
      Bankkey    = Bankkey;
      Accountid  = Accountid;
      Housebnkid = Housebnkid;
      Bankname   = Bankname;
      Waers      = Waers;
    }
}

