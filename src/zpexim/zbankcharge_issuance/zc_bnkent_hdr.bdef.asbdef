projection;
strict;
use draft;
use  side effects;

define behavior for ZC_BNKENT_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action Post ;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

//   field( features : instance, readonly )Belnr,Gjahr ;

  use association _item2 { create; with draft; }
  use association _item { create; with draft; }
  use association _item1 { create; with draft; }
}

define behavior for ZC_BNKENT_BG_I //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}

define behavior for ZC_BNKENT_EXP_I //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}

define behavior for ZC_BNKENT_IMP_I //alias <alias_name>
{
  use update;
  use delete;

  use association _head { with draft; }
}