@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Interface View for Commercial Invoice'
define root view entity ZI_COMM_HED
  as select from zdt_comm_hed
  composition [0..*] of ZI_COMPRINTFLD as _item
{
  key id              as Id,
  key commid          as Commid,
      bankrefno       as Bankrefno,
      ladingno        as Ladingno,
      ladingdt        as Ladingdt,
      billcloseflag   as Billcloseflag,
      fundplanremark  as Fundplanremark,
      isfsenddt       as Isfsenddt,
      lcbankadd1      as Lcbankadd1,
      lcbankadd2      as Lcbankadd2,
      boeddt          as Boeddt,
      docpresentbnkdt as Docpresentbnkdt,
      swiftdt         as Swiftdt,
      scrollno        as Scrollno,
      vesselsaildt    as Vesselsaildt,
      initmationdt    as Initmationdt,
      paymentprocess  as Paymentprocess,
      scripno         as Scripno,
      shbillrecddt    as Shbillrecddt,
      correctblsendon as Correctblsendon,
      draftblcnfdt    as Draftblcnfdt,
      blrcvdt         as Blrcvdt,
      docsentcustdt   as Docsentcustdt,
      atadate         as Atadate,
      drftblrcvdt     as Drftblrcvdt,
      rotationno      as Rotationno,
      tpno            as Tpno,
      tpdate          as Tpdate,
      //leodate         as Leodate,
      ebrcno          as Ebrcno,
      ebrcrcvdt       as Ebrcrcvdt,
      waers           as Waers,
      ebrcvalfc       as Ebrcvalfc,
      awbno           as Awbno,
      rcvconsignbnkdt as Rcvconsignbnkdt,
      planingweek     as Planingweek,
      planingmonth    as Planingmonth,
      custrqstdt      as Custrqstdt,
      createdat       as createdat,
      tprint          as Tprint,
      cprint          as Cprint,
      csprint         as Csprint,
      fobprint        as Fobprint,
      customercode    as Customercode,
      customername    as Customername,
      gstinvno        as Gstinvno,
      invdate         as Invdate,
      sono            as Sono,
      salesnoteno     as Salesnoteno,
      itemcode        as Itemcode,
      itemname        as Itemname,
      indexno         as Indexno,
      polineno        as Polineno,
      pono            as Pono,
      podate          as Podate,
      uom             as Uom,
      quantity        as Quantity,
      sumquantity     as Sumquantity,
      stuffingdate    as Stuffingdate,
      containerno     as Containerno,
      shippingline    as Shippingline,
      companyname     as Companyname,
      comadd1         as Comadd1,
      comadd2         as Comadd2,
      creationdate    as Creationdate,
      creationtime    as Creationtime,
      vesselcode      as Vesselcode,
      vesselname      as Vesselname,
      documentdate    as Documentdate,
      'X'             as updateitem,
      flag            as Flag,
      descgoods1      as Descgoods1,
      descgoods2      as Descgoods2,
      payrecvbank     as Payrecvbank,
      payrecvbankadrc as Payrecvbankadrc,
      remarks1        as Remarks1,
      remarks2        as Remarks2,
      irmno           as Irmno,

      _item

}
