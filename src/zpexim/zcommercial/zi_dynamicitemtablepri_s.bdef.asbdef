managed with additional save implementation in class ZBP_I_DYNAMICITEMTABLEPRI_S unique;
strict;
with draft;
define behavior for ZI_DynamicItemTablePri_S alias DynamicItemTableAll
draft table ZDT_PRINTFI_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _DynamicItemTablePri { create ( features : instance ); with draft; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_DynamicItemTablePri alias DynamicItemTablePri ##UNMAPPED_FIELD
persistent table ZDT_PRINTFIELD
draft table ZDT_PRINTFIEL_D
lock dependent by _DynamicItemTableAll
authorization dependent by _DynamicItemTableAll

{
  field ( mandatory : create )
   Field;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Field;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_PRINTFIELD
  {
    Field = FIELD;
    Fieldname = FIELDNAME;
    Printallow = PRINTALLOW;
    Printseq = PRINTSEQ;
  }

  association _DynamicItemTableAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}