managed implementation in class zbp_i_shipins_hdr unique;
strict(1);
with draft;

define behavior for ZI_SHIPINS_HDR //alias <alias_name>
persistent table zdt_shipinst_hdr
draft table zdr_shipinst_hdr
with additional save
lock master
total etag Creationdate
authorization master ( instance )
//etag master <field_name>
{
draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }
  field ( readonly : update, numbering : managed ) Id;
  field ( mandatory : create, readonly : update ) Bookingno;
  field ( readonly ) Shippingtype, Consadd1,Constreet1 ;
  field ( features : instance ) Deliveradd,Deliveradd1,Deliveradd2,Expcarrvoyage,Loadingpier,
                               Notifyp1add1,Notifyp1add2,Notifyp1name,Notifyp2add1,Notifyp2add2,
                               Notifyp2name,Notifyp3add1,Notifyp3add2,Notifyp3name,Shipmenttype;
  create;
  update ( features : instance );
  delete ( features : instance );
  determination headerdetails on modify { field Bookingno; }
  side effects { field Bookingno affects field Consadd1,field Constreet1,field Shippingtype; }
  action ( features : instance ) Cancel result [1] $self;
  action ( features : instance ) Print result [1] $self;
  mapping for ZI_SHIPINS_HDR
  {
     Bookingno = Bookingno;
     Consadd1 = Consadd1;
     Constreet1 = Constreet1;
     Deliveradd = Deliveradd;
     Deliveradd1 = Deliveradd1;
     Deliveradd2 = Deliveradd2;
     Expcarrvoyage = Expcarrvoyage;
     Loadingpier = Loadingpier;
     Notifyp1add1 = Notifyp1add1;
     Notifyp1add2 = Notifyp1add2;
     Notifyp1name = Notifyp1name;
     Notifyp2add1 = Notifyp2add1;
     Notifyp2add2 = Notifyp2add2;
     Notifyp2name = Notifyp2name;
     Notifyp3add1 = Notifyp3add1;
     Notifyp3add2 = Notifyp3add2;
     Notifyp3name = Notifyp3name;
     Shipmenttype = Shipmenttype;
     Shippingtype = Shippingtype;
     Tprint       = Tprint;
  }

}