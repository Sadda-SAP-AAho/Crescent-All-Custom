@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'cdate', direction:  #DESC }],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'Pre-Shipment/Post-Shipment Doc. Clubbing' }]
     }


@UI: { headerInfo: { title: { type: #STANDARD, label: 'SAP Clubbing No.', value: 'clubnointernal' } } }

annotate view ZC_EXIMCLUBHDR with
{

  @UI.facet:
   [

   {
   id: 'GeneralData',
   isSummary: true,
   label: 'Document Header',
   type: #COLLECTION
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'GeneralData1',
   parentId: 'GeneralData',
   label: 'Main Information',
   position: 10,
   id: 'GeneralData1'
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'GeneralData2',
   parentId: 'GeneralData',
   label: 'Amount',
   position: 20,
   id: 'GeneralData2'
   },

   {
   id: 'Item3',
   label: 'Document Item',
   type: #LINEITEM_REFERENCE,
   targetElement: '_item'
   }

   ]

  @UI.hidden: true
  id;

  @UI: {
         fieldGroup: [{qualifier: 'GeneralData1',position: 10,importance: #HIGH }]
  }
  clubnointernal;

  @UI: {
         lineItem: [ { position: 20} ],
         identification: [{position: 20 }],
         selectionField: [{ position: 10 }],
         fieldGroup: [{qualifier: 'GeneralData1',position: 20,importance: #HIGH }]
  }
  clubnoexternal;

  @UI: {
         lineItem: [ { position: 30} ],
         identification: [{position: 30 }],
         fieldGroup: [{qualifier: 'GeneralData1',position: 30,importance: #HIGH }]
  }

  @Consumption.valueHelpDefinition: [{
        entity:{
        element: 'value_low',
        name:'ZI_EXIMCLUBDOCTYPE'
        },
        distinctValues: true,
        useForValidation: true,
        enabled: '',

        additionalBinding:
        [
        {
          localParameter: '',
          localElement: 'documenttypedesc',
          localConstant: '',
          parameter: '',
          element: 'text',
          usage: #RESULT
         }
         ]
        }
      ]
  documenttype;

  @UI: {
         lineItem: [ { position: 35} ],
         identification: [{position: 35 }],
         fieldGroup: [{qualifier: 'GeneralData1',position: 35,importance: #HIGH }]
  }
  documenttypedesc;

  @UI: {
         fieldGroup: [{qualifier: 'GeneralData1',position: 45,importance: #HIGH }]
  }
  clubcomment;

  @UI: {
         lineItem: [ { position: 50} ],
         identification: [{position: 50 }],
         selectionField: [{ position: 20 }],
         fieldGroup: [{qualifier: 'GeneralData1',position: 50,importance: #HIGH }]
  }
  cdate;

  @UI: {
        lineItem: [ { position: 55} ],
        identification: [{position: 55 }],
        fieldGroup: [{qualifier: 'GeneralData1',position: 55,importance: #HIGH }]
  }
  ctime;

  @UI: {
        lineItem: [ { position: 60} ],
        identification: [{position: 60 }],
        fieldGroup: [{qualifier: 'GeneralData1',position: 60,importance: #HIGH }]
  }
  cuser;

  @UI: {
        lineItem: [ { position: 70} ],
        identification: [{position: 70 }, { type: #FOR_ACTION, dataAction: 'Cancel', label: 'Cancel'}],
        fieldGroup: [{qualifier: 'GeneralData1',position: 70,importance: #HIGH }]
  }
  deleted;

  @UI: {
        lineItem: [ { position: 75} ],
        identification: [{position: 75 }, { type: #FOR_ACTION, dataAction: 'Release', label: 'Release'}],
        selectionField: [{ position: 30 }],
        fieldGroup: [{qualifier: 'GeneralData1',position: 75,importance: #HIGH }]
  }
  released;

  @UI: {
        lineItem: [ { position: 80} ],
        identification: [{position: 80 }],
        fieldGroup: [{qualifier: 'GeneralData2',position: 10,importance: #HIGH }]
  }
  fobamount;

  @UI: {
        lineItem: [ { position: 80} ],
        identification: [{position: 80 }],
        fieldGroup: [{qualifier: 'GeneralData2',position: 20,importance: #HIGH }]
  }
  fobcurrency;

}