managed with additional save implementation in class ZBP_I_TABLEFORLCTYPE_S unique;
strict;
with draft;
define behavior for ZI_TableForLcType_S alias TableForLcTypeAll
draft table ZDT_LCTYPEF_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( notrigger )
   SingletonID,
   HideTransport,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare {
    validation TableForLcType ~ ValidateDataConsistency;
  }
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TableForLcType { create ( features : instance ); with draft; }
}

define behavior for ZI_TableForLcType alias TableForLcType
persistent table ZDT_LCTYPEF4
draft table ZDT_LCTYPEF4_D
etag master LocalLastChangedAt
lock dependent by _TableForLcTypeAll
authorization dependent by _TableForLcTypeAll

{
  field ( mandatory : create )
   Type;

  field ( readonly )
   SingletonID,
   LastChangedAt,
   LocalLastChangedAt,
   ConfigDeprecationCode;

  field ( readonly : update )
   Type;

  field ( notrigger )
   SingletonID,
   LastChangedAt,
   LocalLastChangedAt;


  update( features : global );
  delete( features : instance );

  action ( features : instance ) Deprecate result [1] $self;
  action ( features : instance ) Invalidate result [1] $self;
  factory action ( features : instance ) CopyTableForLcType parameter ZD_CopyTableForLcTypeP [1];

  mapping for ZDT_LCTYPEF4
  {
    Type = TYPE;
    TypeDesc = TYPE_DESC;
    ConfigDeprecationCode = CONFIGDEPRECATIONCODE;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

  association _TableForLcTypeAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
  validation ValidateDataConsistency on save { create; update; }
}