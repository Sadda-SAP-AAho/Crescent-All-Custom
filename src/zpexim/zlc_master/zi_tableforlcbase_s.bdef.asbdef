managed with additional save implementation in class ZBP_I_TABLEFORLCBASE_S unique;
strict;
with draft;
define behavior for ZI_TableForLcBase_S alias TableForLcBaseAll
draft table ZDT_LCBASEF_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( notrigger )
   SingletonID,
   HideTransport,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare {
    validation TableForLcBase ~ ValidateDataConsistency;
  }
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TableForLcBase { create ( features : instance ); with draft; }
}

define behavior for ZI_TableForLcBase alias TableForLcBase
persistent table ZDT_LCBASEF4
draft table ZDT_LCBASEF4_D
etag master LocalLastChangedAt
lock dependent by _TableForLcBaseAll
authorization dependent by _TableForLcBaseAll

{
  field ( mandatory : create )
   Base;

  field ( readonly )
   SingletonID,
   LastChangedAt,
   LocalLastChangedAt,
   ConfigDeprecationCode;

  field ( readonly : update )
   Base;

  field ( notrigger )
   SingletonID,
   LastChangedAt,
   LocalLastChangedAt;


  update( features : global );
  delete( features : instance );

  action ( features : instance ) Deprecate result [1] $self;
  action ( features : instance ) Invalidate result [1] $self;
  factory action ( features : instance ) CopyTableForLcBase parameter ZD_CopyTableForLcBaseP [1];

  mapping for ZDT_LCBASEF4
  {
    Base = BASE;
    BaseDesc = BASE_DESC;
    ConfigDeprecationCode = CONFIGDEPRECATIONCODE;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

  association _TableForLcBaseAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
  validation ValidateDataConsistency on save { create; update; }
}