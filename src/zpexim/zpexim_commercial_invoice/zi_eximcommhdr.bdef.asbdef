managed implementation in class zbp_i_eximcommhdr unique;
strict;
with draft;

define behavior for ZI_EXIMCOMMHDR alias head
persistent table zexim_comm_hdr
draft table zeximcommhdrdr
lock master
total etag LocalLastChangedAt
authorization master ( instance )
{
  create;
  update ( features : instance );
  delete ( features : instance );

  field ( numbering : managed ) id;
  field ( mandatory : create, readonly : update ) Invclubnointernal;

  field ( readonly ) Deleted, Invclubnodate, Invclubnoexternal, Invcommdate, Invcommtime,
  Invcommuser, Released, fobamount, fobcurrency, Status;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  //Actions
  action ( features : instance ) Cancel result [1] $self;
  action ( features : instance ) Release result [1] $self;
  action ( features : instance ) Print result [1] $self;

  side effects
  {
    field Invclubnointernal affects field Invclubnoexternal, field Invclubnodate, field Invcommdate, field Invcommtime,
        field Invcommuser, field fobamount, field fobcurrency, field Status;
  }

  determination updatefields on modify { field Invclubnointernal; }
  determination updateitem on save { create; update; }
  validation validatehead on save { create; update; }
  validation validateoverall on save { create; update; }

  association _add { create ( features : instance ); with draft; }
  association _cnh { create ( features : instance ); with draft; }
  association _cni { create ( features : instance ); with draft; }
  association _cus { create ( features : instance ); with draft; }
  association _itm { create ( features : instance ); with draft; }
  association _pay { create ( features : instance ); with draft; }
  association _shp { create ( features : instance ); with draft; }

  mapping for zi_eximcommhdr
    {
      Dateofdischarge    = Dateofdischarge;
      Deleted            = Deleted;
      Invclubnodate      = Invclubnodate;
      Invclubnoexternal  = Invclubnoexternal;
      Invclubnointernal  = Invclubnointernal;
      Invcommdate        = Invcommdate;
      Invcommtime        = Invcommtime;
      Invcommuser        = Invcommuser;
      LastChangedAt      = LastChangedAt;
      LocalCreatedAt     = LocalCreatedAt;
      LocalCreatedBy     = LocalCreatedBy;
      LocalLastChangedAt = LocalLastChangedAt;
      LocalLastChangedBy = LocalLastChangedBy;
      Released           = Released;
      Tprint             = Tprint;
      fobamount          = fobamount;
      fobcurrency        = fobcurrency;
      Status             = Status;
    }

}

define behavior for ZI_EXIMCOMMADD alias add
persistent table zexim_comm_add
draft table zeximcommadddr
lock dependent by _head
authorization dependent by _head
//etag master <field_name>
{
  update ( features : instance );
  delete ( features : instance );
  field ( readonly ) Id;

  field ( mandatory : create ) Paymenttext, Materialdesc1, Invoiceremarks1;

  field ( numbering : managed ) Item;

  determination updateitem on save { create; update; }
  validation validate on save { create; update; }

  association _head;

  mapping for zi_eximcommadd
    {
      Item            = Item;
      Paymenttext     = Paymenttext;
      Invoiceremarks1 = Invoiceremarks1;
      Invoiceremarks2 = Invoiceremarks2;
      Invoiceremarks3 = Invoiceremarks3;
      Taxremarks      = Taxremarks;
      Materialdesc1   = Materialdesc1;
      Materialdesc2   = Materialdesc2;
      Materialdesc3   = Materialdesc3;
    }
}

