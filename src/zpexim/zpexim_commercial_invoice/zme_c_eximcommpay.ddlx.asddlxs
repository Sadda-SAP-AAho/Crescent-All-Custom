@Metadata.layer: #CORE

@UI: {
        presentationVariant: [{ sortOrder: [{ by: 'Paymentterms', direction:  #DESC }],
                                visualizations: [{type: #AS_LINEITEM}],
                                text: 'Payment' }]
     }

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Payment', value: 'Paymentterms' } } }

annotate view ZC_EXIMCOMMPAY with
{

  @UI.facet: [
   {
   id: 'GeneralI',
   isSummary: true,
   label: 'General Information',
   type: #COLLECTION,
   purpose: #STANDARD
   },

