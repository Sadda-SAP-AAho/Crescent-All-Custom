@Metadata.layer: #CORE

@UI: {
        presentationVariant: [{ sortOrder: [{ by: 'Addresstypedesc', direction:  #DESC }],
                                visualizations: [{type: #AS_LINEITEM}],
                                text: 'Address' }]
     }

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Address Type', value: 'Addresstypedesc' } } }

annotate view ZC_EXIMCOMMCUS with
{

  @UI.facet: [
  {
  id: 'GeneralI',
  isSummary: true,
  label: 'General Information',
  type: #COLLECTION,
  purpose: #STANDARD
  },

