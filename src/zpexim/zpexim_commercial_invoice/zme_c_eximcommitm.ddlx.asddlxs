       identification: [{position: 180 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 180,importance: #HIGH }]
  }
  Deliveryitem;

  @UI: {
       lineItem: [ { position: 190} ],
       identification: [{position: 190 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 190,importance: #HIGH }]
  }
  Salesorder;

  @UI: {
       //lineItem: [ { position: 200} ],
       identification: [{position: 200 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 200,importance: #HIGH }]
  }
  Salesorderitem;

  @UI: {
       lineItem: [ { position: 210} ],
       identification: [{position: 210 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 210,importance: #HIGH }]
  }
  @UI.hidden: true
  Contract;

  @UI: {
       //lineItem: [ { position: 220} ],
       identification: [{position: 220 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 220,importance: #HIGH }]
  }
  @UI.hidden: true
  Contractitem;

  @UI: {
       lineItem: [ { position: 230} ],
       identification: [{position: 230 }],
       fieldGroup: [{qualifier: 'GeneralData2',position: 230,importance: #HIGH }]
  }
  Reference;

}