managed implementation in class zbp_i_nostro_hed unique;
strict;
with draft;

define behavior for ZI_NOSTRO_hed //alias <alias_name>
persistent table zdt_nostro_hed
draft table zdr_nostro_hed
lock master
total etag Invoiceno
authorization master ( instance )
//etag master <field_name>

{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  //  //=== Custom action Button ====//
  //  action ( features : instance ) Accupdate result [1] $self;

  field ( readonly : update, numbering : managed ) Id;
  field ( mandatory : create, readonly : update ) Companycode, Customer, fiscalyear, refaccdocno;
  field ( readonly : update ) Invoiceno;
  field ( readonly ) Postingdate, Customername;

  create;
  update ( features : instance );
  delete ( features : instance );

  determination updatedata on save { create; update; }
  determination updatedatahdr on modify { field Companycode; field Customer; field Invoiceno; create; }
  //  validation checkdel on save { create; }

  validation payterm on save { create; update; }

  association _Item { create ( features : instance ); with draft; }
  association _Item2 { create ( features : instance ); with draft; }


  mapping for zi_nostro_hed
    {
      Companycode  = Companycode;
      Customer     = Customer;
      Customername = Customername;
      Invoiceno    = Invoiceno;
      Postingdate  = Postingdate;
      refaccdocno  = refaccdocno;
    }
}
