// Item Line Start
//-------------------------------------------------------------------------------
define behavior for ZI_NOSTRO_itm //alias <alias_name>
persistent table zdt_nostro_itm
draft table zdr_nostro_itm
lock dependent by _Head
authorization dependent by _Head
//etag master <field_name>
{
  update;
  delete ( features : instance );
  field ( readonly : update, numbering : managed ) Item;

  //  //=== Custom action Button ====//
  //  action ( features : instance ) Accupdateitm result [1] $self;

  field ( readonly ) Id, Accountingdocument, accountingdocumentitem, Accountingdocumenttype, Documentdate, Postingdate,
  Amountdc, remainamtdc, Amountcc, Currencydc, Currencycc, payterm, Duedate, Referenceno;

  //  field ( features : instance ) Checkbox, Swiftdate, Currencyinward, Inwardrecordstatus;
  //  field ( features : instance, mandatory ) Inwardrefno, Inwarddate, Inwardamount;
  //  validation val_inwarditm2 on save { create; }

  //  determination update_amt on save { create; update; }

  //  validation nostro_check on save { create; update; }

  association _Head { with draft; }
  mapping for zi_nostro_itm
    {
      Checkbox               = Checkbox;
      Accountingdocument     = Accountingdocument;
      accountingdocumentitem = accountingdocumentitem;
      Referenceno            = Referenceno;
      Accountingdocumenttype = Accountingdocumenttype;
      Documentdate           = Documentdate;
      Postingdate            = Postingdate;
      Amountdc               = Amountdc;
      Currencydc             = Currencydc;
      remainamtdc            = remainamtdc;
      Amountcc               = Amountcc;
      Currencycc             = Currencycc;
      payterm                = payterm;
      Duedate                = Duedate;
      Inwardrefno            = Inwardrefno;
      Inwarddate             = Inwarddate;
      Swiftdate              = Swiftdate;
      Inwardamount           = Inwardamount;
      Currencyinward         = Currencyinward;
      Inwardrecordstatus     = Inwardrecordstatus;
      Accupdateitm           = Accupdateitm;
    }
}

