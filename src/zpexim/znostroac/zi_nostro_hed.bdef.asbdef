define behavior for ZI_NOSTRO_ITM2 //alias <alias_name>
persistent table zdt_nostro_itm2
draft table zdr_nostro_itm2
lock dependent by _Head
authorization dependent by _Head
//etag master <field_name>
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly : update, numbering : managed ) Item2;

  field ( mandatory : create, readonly : update ) accountingdocumentitem;//, payterm;
  field ( readonly : update ) payterm;

  //=== Custom action Button ====//
  action ( features : instance ) Accupdateitm result [1] $self;

  field ( readonly ) Id, Accountingdocument, Accountingdocumenttype, Documentdate, Postingdate,
  Amountdc, remainamtdc, Amountcc, Currencydc, Currencycc, Duedate, Referenceno, bankrefno;

  field ( features : instance ) Swiftdate, Currencyinward, Inwardrecordstatus,Bankintidt;
  field ( features : instance, mandatory ) Inwardrefno, Inwarddate, Inwardamount;

  determination updatedataitm2 on modify { create; }
  determination update_rem_amt on modify { field Inwardamount; }


  //  validation val_inwarditm2 on save  { field Inwardrefno; field Inwarddate; field Inwardamount; create; update; }
  //  determination update_rem_amt1 on save  { delete; }
  validation payterm on save { create; update; }

  side effects
  {
    field Inwardamount affects field Remainamtdc;
  }
  association _Head { with draft; }

  mapping for zi_nostro_itm2
    {
      Accountingdocument     = Accountingdocument;
      accountingdocumentitem = accountingdocumentitem;
      Referenceno            = Referenceno;
      Amountdc               = Amountdc;
      Currencydc             = Currencydc;
      remainamtdc            = remainamtdc;
      payterm                = payterm;
      Duedate                = Duedate;
      Inwardrefno            = Inwardrefno;
      Inwarddate             = Inwarddate;
      Swiftdate              = Swiftdate;
      Inwardamount           = Inwardamount;
      Currencyinward         = Currencyinward;
      Inwardrecordstatus     = Inwardrecordstatus;
      Accupdateitm           = Accupdateitm;
      bankrefno              = bankrefno;
      Bankintidt              = Bankintidt;
    }
}