managed with additional save implementation in class ZBP_I_TMGTABLEFORSHIPPING_S unique;
strict;
with draft;
define behavior for ZI_TmgTableForShipping_S alias TmgTableForShippAll
draft table zdt_shiplin_d_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )

{
  field ( readonly )
  SingletonID;

  field ( features : instance )
  TransportRequestID;

  field ( notrigger )
  SingletonID,
  LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TmgTableForShipping { create ( features : instance ); with draft; }

  side effects
  {
    action SelectCustomizingTransptReq affects $self;
  }
}

define behavior for ZI_TmgTableForShipping alias TmgTableForShipping ##UNMAPPED_FIELD
persistent table zdt_shipline_tmg
draft table zdt_shipline__d
lock dependent by _TmgTableForShippAll
authorization dependent by _TmgTableForShippAll

{
  field ( mandatory : create )
  Scode;

  field ( readonly )
  SingletonID;

  field ( readonly : update )
  Scode;

  field ( notrigger )
  SingletonID;


  update ( features : global );
  delete ( features : global );

  mapping for zdt_shipline_tmg
    {
      Scode     = SCODE;
      Sline     = SLINE;
      Slinename = SLINENAME;
      Slinegt   = SLINEGT;
    }

  association _TmgTableForShippAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}