projection;
strict;
use draft;

define behavior for ZC_DELDASH_HDR //alias <alias_name>
{
  use create;
  use update;
 // use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action Print;
  use action Cancel;

  use association _Item { create; with draft; }
}

define behavior for ZC_DELDASH_ITM //alias <alias_name>
{
    use update;
 // use delete;

  use association _Head { with draft; }
}