@EndUserText.label: 'Interface View for Delivery Dash Header'
@AccessControl.authorizationCheck: #CHECK
@ObjectModel.representativeKey: 'id'
@ObjectModel.usageType.dataClass: #TRANSACTIONAL
@ObjectModel.usageType.serviceQuality: #A
@ObjectModel.usageType.sizeCategory: #L
define root view entity ZI_DELDASH_HDR
  as select from zdt_deldash_hdr
  composition [0..*] of ZI_DELDASH_ITM as _Item
{
  key id             as Id,
      delivery       as Delivery,
      revision       as Revision,
      chaname        as Chaname,
      pacmark        as Pacmark,
      packrelfac     as Packrelfac,
      scomdec        as Scomdec,
      femadec        as Femadec,
      lcno           as Lcno,
      lcdt           as Lcdt,
      issbnkname     as Issbnkname,
      consize        as Consize,
      consizen       as Consizen,
      docrelchadt    as Docrelchadt,
      conliftdt      as Conliftdt,
      confacindt     as Confacindt,
      conpckvaldt    as Conpckvaldt,
      conpckletdt    as Conpckletdt,
      shipbillno     as Shipbillno,
      shpbilldt      as Shpbilldt,
      cartordrecdt   as Cartordrecdt,
      vesselno       as Vesselno,
      contno         as Contno,
      stuffdt        as Stuffdt,
      bookingno      as Bookingno,
      porttrans      as Porttrans,
      lorryno        as Lorryno,
      scriptdt       as Scriptdt,
      rfidsealno     as Rfidsealno,
      delmode        as Delmode,
      latordrecrem   as Latordrecrem,
      latcondocrem   as Latcondocrem,
      precarby       as Precarby,
      por            as Por,
      carsealno      as Carsealno,
      shipline       as Shipline,
      conname        as Conname,
      carordappdt    as Carordappdt,
      etadt          as Etadt,
      concutoffdt    as Concutoffdt,
      etddt          as Etddt,
      finalseal      as Finalseal,
      detrecchadt    as Detrecchadt,
      sisentdt       as Sisentdt,
      condockindt    as Condockindt,
      shiptype       as Shiptype,
      empretdt       as Empretdt,
      thrdprtyfor    as Thrdprtyfor,
      forwarder      as forwarder,
      forwardernam   as forwardernam,
      shpprtycode    as Shpprtycode,
      shpprtyname    as Shpprtyname,
      shpprtyadd1    as Shpprtyadd1,
      shpprtyadd2    as Shpprtyadd2,
      lutigst        as Lutigst,
      pol            as Pol,
      pod            as Pod,
      findes         as Findes,
      coo            as Coo,
      cod            as Cod,
      cusmar         as Cusmar,
      descgoods      as Descgoods,
      descgoods1     as Descgoods1,
      vessaildt      as Vessaildt,
      ordepdt        as Ordepdt,
      atadt          as Atadt,
      salesnoteref   as Salesnoteref,
      invprint       as Invprint,
      placedel       as Placedel,
      imono          as Imono,
      status         as Status,
      cancel         as Cancel,
      canind         as Canind,
      cancelby       as Cancelby,
      cancelon       as Cancelon,
      textfield1     as Textfield1,
      textfield2     as Textfield2,
      flag           as Flag,
      freightremarks as Freightremarks,
      contdisfact    as Contdisfact,
      contpickfrm    as Contpickfrm,
      leodate        as leodate,
      _Item // Make association public
}
