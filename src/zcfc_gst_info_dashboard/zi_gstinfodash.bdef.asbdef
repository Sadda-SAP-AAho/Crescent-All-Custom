managed implementation in class zbp_i_gstinfodash unique;
strict;
with draft;

define behavior for ZI_GSTINFODASH
persistent table zdt_gstinfodash
draft table zdr_gstinfodash

lock master
total etag Jeno
authorization master ( instance )
//etag master <field_name>
{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
  }

  create;
  update ( features : instance );
  delete ( features : instance );

  field ( readonly : update, numbering : managed ) Id;
  field ( mandatory : create, readonly : update ) Fisyear, Jeno, Jedate;
  field ( readonly ) Lastchngedt, Lastchnngtm;

  field ( features : instance )
  Documenttype,
  Journalentrytype,
  Documentno,
  Vendorcode,
  Vendorname,
  Invoicedrno,
  Invoicedrdate,
  Gstno,
  State,
  Sumtaxablevalue,
  Sumcgst,
  Sumsgst,
  Sumigst,
  Sumrcmcgst,
  Sumrcmsgst,
  Sumrcmigst,
  Sumtotalinvvalue,
  Twobrefno,
  Gstremarks,
  Newgstno,
  Gstmonth,
  Extra1,
  Extra2;

  determination savedata on modify
  {
    field Fisyear;
    field Documenttype;
    field Journalentrytype;
    field Documentno;
    field Vendorcode;
    field Vendorname;
    field Invoicedrno;
    field Invoicedrdate;
    field Gstno;
    field State;
    field Sumtaxablevalue;
    field Sumcgst;
    field Sumsgst;
    field Sumigst;
    field Sumrcmcgst;
    field Sumrcmsgst;
    field Sumrcmigst;
    field Sumtotalinvvalue;
    field Twobrefno;
    field Gstremarks;
    field Newgstno;
    field Gstmonth;
    field Extra1;
    field Extra2;
  }

  validation checkdet on save { create; }

  action ( features : instance ) deleteall result [1] $self;

  mapping for zi_gstinfodash
    {
      Fisyear          = fisyear;
      Jeno             = jeno;
      Jedate           = jedate;
      Documenttype     = documenttype;
      Journalentrytype = journalentrytype;
      Documentno       = documentno;
      Vendorcode       = vendorcode;
      Vendorname       = vendorname;
      Invoicedrno      = invoicedrno;
      Invoicedrdate    = invoicedrdate;
      Gstno            = gstno;
      State            = state;
      Sumtaxablevalue  = sumtaxablevalue;
      Sumcgst          = sumcgst;
      Sumsgst          = sumsgst;
      Sumigst          = sumigst;
      Sumrcmcgst       = sumrcmcgst;
      Sumrcmsgst       = sumrcmsgst;
      Sumrcmigst       = sumrcmigst;
      Sumtotalinvvalue = sumtotalinvvalue;
      Twobrefno        = twobrefno;
      Gstremarks       = gstremarks;
      Newgstno         = newgstno;
      Gstmonth         = gstmonth;
      Extra1           = extra1;
      Extra2           = extra2;
      Lastchngedt      = Lastchngedt;
      Lastchnngtm      = Lastchnngtm;
    }

}