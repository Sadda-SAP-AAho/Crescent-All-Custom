managed implementation in class zbp_i_gstinfupd_hd unique;
strict;
with draft;

define behavior for ZI_GSTINFUPD_HD //alias <alias_name>
persistent table zdt_gstinfupd_hd
draft table zdr_gstinfupd_hd
lock master
total etag id
authorization master ( instance )
with additional save
//etag master <field_name>
{

  draft action( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  create;
  update ( features : instance );
  delete ( features : instance );
  field ( numbering : managed, readonly ) id;
  field ( readonly ) status, FileStatus, internalno, post, local_created_at, local_created_by ;
  field ( features : instance ) Comments, Attachment;

  action ( features : instance ) uploadExcelData result [1] $self;
  action ( features : instance ) valid result [1] $self;
  action ( features : instance ) upd result [1] $self;

  validation validate_fields on save { create; update; }
  determination change_status on save { create; update; }
  determination fields on modify { field Filename; }

  side effects {
  action valid affects entity _item;
  action upd affects entity _item;
  }

  association _item { create ( features : instance ); with draft; }
}

define behavior for ZI_GSTINFUPD_IT //alias <alias_name>
persistent table zdt_gstinfupd_it
draft table zdr_gstinfupd_it
lock dependent by _head
authorization dependent by _head
//etag master <field_name>
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly ) Id, Fisyear, Jeno, Documenttype, Journalentrytype, Documentno,
                     Vendorcode, Vendorname, Invoicedrno, Invoicedrdate, Gstno, State,
                     Sumtaxablevalue, Sumcgst, Sumsgst, Sumigst, Sumrcmcgst, Sumrcmsgst,
                     Sumrcmigst, Sumtotalinvvalue, Twobrefno, Gstremarks, Newgstno,
                     Gstmonth, Extra1, Extra2,
                     msg, Updstatus, Crcriticalitystatus, Status;

  association _head;
}