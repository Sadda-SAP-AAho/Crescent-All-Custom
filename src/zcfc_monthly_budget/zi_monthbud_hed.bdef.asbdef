managed implementation in class zbp_i_monthbud_hed unique;
strict;
with draft;

define behavior for ZI_MONTHBUD_HED //alias <alias_name>
persistent table zdt_monthbud_hed
draft table zdr_monthbud_hed
lock master
total etag budgetcode
authorization master ( instance )
//etag master <field_name>
{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  field ( readonly : update, numbering : managed ) Id;
  field ( readonly ) budgetcode;

  create;
  update;
  delete;
  determination determinedocnum on save { create; }

  association _Item { create; }

  validation checkcomb on save { create; update; }
  validation checkvalidation on save { create; update; }


  mapping for zi_monthbud_hed
    {
      Keyid      = Keyid;
      Creon      = Creon;
      Creby      = Creby;
      Budgetcode = Budgetcode;
      Budgetname = Budgetname;
      Fiscalyear = Fiscalyear;
      Currency   = Currency;
    }
}

define behavior for ZI_MONTHBUD_ITM //alias <alias_name>
