projection;
strict ( 1 );
use draft;

define behavior for ZC_MONTHBUD_HED //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; }
}

define behavior for ZC_MONTHBUD_ITM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}