managed with additional save implementation in class ZBP_I_LOCATION_S unique;
strict;
with draft;
define behavior for ZI_Location_S alias LocationAll
draft table ZDT_LOCATIO_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _Location { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_Location alias Location ##UNMAPPED_FIELD
persistent table ZDT_LOCATION
draft table ZDT_LOCATION_D
lock dependent by _LocationAll
authorization dependent by _LocationAll

{
  field ( mandatory : create )
   Loctncd;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Loctncd;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_LOCATION
  {
    Loctncd = LOCTNCD;
    Loctnnam = LOCTNNAM;
  }

  association _LocationAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}