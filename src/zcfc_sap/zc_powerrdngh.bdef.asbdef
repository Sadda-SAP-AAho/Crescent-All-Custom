{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item {create; with draft;}

}

define behavior for ZC_POWERRDNGL //alias <alias_name>
