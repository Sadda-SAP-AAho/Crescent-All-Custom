projection;
strict;
use draft;
use side effects;
define behavior for ZC_MATINFO_FILE //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action uploadExcelData;
  use action valid;
  use action upd;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; }
}

define behavior for ZC_MATITEM_FILE //alias <alias_name>
{
  use update;
 // use delete;

  use association _head;
}