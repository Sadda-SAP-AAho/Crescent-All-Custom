@Metadata.layer: #CORE

@UI: { headerInfo: {
typeName: 'Material Information Uploader',
typeNamePlural: 'Material Information Uploader',
title: { type: #STANDARD, value: 'internalno' },
         imageUrl: 'Attachment',
         description: { type: #STANDARD, value: 'filename' } },
         presentationVariant: [{
         sortOrder: [{ by: 'internalno', direction: #ASC }],
         visualizations: [{type: #AS_LINEITEM}] }] }
annotate entity ZC_MATINFO_FILE
    with 
{
    @UI.facet:
    [

    {
    id: 'GeneralData',
    isSummary: true,
    label: 'Material Information Uploader',
    type: #COLLECTION,
    position:  1
    },

    {
    type: #FIELDGROUP_REFERENCE,
    targetQualifier: 'GeneralData1',
    parentId: 'GeneralData',
    label: 'Basic Data',
    position: 10,
    id: 'GeneralData1'
    },

    {
    type: #FIELDGROUP_REFERENCE,
    targetQualifier: 'GeneralData2',
    parentId: 'GeneralData',
    position: 30,
    label: 'File Details',
    id: 'GeneralData2'
    },

    {
    id: 'Item1',
    label: 'Material Information Item',
    type: #LINEITEM_REFERENCE,
    targetElement: '_item',
    position : 2
    }
    ]

  @UI.hidden: true
  id;

  @UI: { lineItem:       [ { position: 10, importance: #HIGH , label: 'Internal No.' }  ] ,
         identification: [ { position: 10 , label: 'Internal No.' } ],
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Internal No.', position: 10, importance: #HIGH }] }
  internalno;

  @UI: { lineItem:       [ { position: 20, importance: #HIGH , label: 'Processing Status', criticality: 'CriticalityStatus'} ] ,
         identification: [ { position: 20 , label: 'Processing Status' } ] ,
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Processing Status', position: 20, importance: #HIGH, criticality: 'CriticalityStatus' }] }
  FileStatus;

  @UI: { lineItem:       [ { position: 30, importance: #HIGH , label: 'Description'} ] ,
         identification: [ { position: 30 , label: 'Description' } ] ,
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Description', position: 30, importance: #HIGH }] }
  comments;

  @UI: { lineItem:       [ { position: 35, importance: #HIGH , label: 'Posted?'} ] ,
         identification: [ { position: 35 , label: 'Posted?' } ] ,
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Posted?', position: 35, importance: #HIGH }] }
  post;

  @UI: { fieldGroup: [{ qualifier: 'GeneralData2', position: 10, label: 'Attachment', importance: #HIGH }] }
  attachment;

  @UI: { lineItem:       [ { position: 40, importance: #HIGH , label: 'File Name'} ] ,
         identification: [ { position: 40 , label: 'File Name' } ]  }
  filename;

  @UI: { lineItem:       [ { position: 50, importance: #HIGH , label: 'Created At'} ] ,
         identification: [ { position: 50 , label: 'Created At' } ],
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Created At', position: 50, importance: #HIGH }]}
  local_created_at;

  @UI: { lineItem:       [ { position: 60, importance: #HIGH , label: 'Created By'} ] ,
         identification: [ { position: 60 , label: 'Created By' } ],
         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Created By', position: 60, importance: #HIGH }]  }
  local_created_by;

  @UI.hidden: true
  mimetype;

  @UI.hidden: true
  local_last_changed_at;
  
  
  @UI.hidden: true
  @UI: { identification: [{ position: 390 },
                         { type: #FOR_ACTION, dataAction: 'Valid', label: 'Validate', iconUrl: 'sap-icon://close-command-field' }],
          fieldGroup: [{ qualifier: 'GeneralData3', position: 390, importance: #HIGH }] }
  Valid;
  @UI: { identification: [{ position: 400 },
                         { type: #FOR_ACTION, dataAction: 'Upd', label: 'Update', iconUrl: 'sap-icon://close-command-field' }],
          fieldGroup: [{ qualifier: 'GeneralData3', position: 400, importance: #HIGH }] }
  Upd;        

    
}