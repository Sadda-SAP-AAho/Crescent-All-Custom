managed with additional save implementation in class ZBP_I_TMGTABLEFORMOULDDET_S unique;
strict;
with draft;
define behavior for ZI_TmgTableForMouldDet_S alias TmgTableForMouldAll
draft table ZDT_MOULD_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TmgTableForMouldDet { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_TmgTableForMouldDet alias TmgTableForMouldDet ##UNMAPPED_FIELD
persistent table ZDT_MOULD
draft table ZDT_MOULD_D
lock dependent by _TmgTableForMouldAll
authorization dependent by _TmgTableForMouldAll

{
  field ( mandatory : create )
   Mould;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Mould;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZDT_MOULD
  {
    Mould = MOULD;
    Rate1 = RATE1;
  }

  association _TmgTableForMouldAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
}