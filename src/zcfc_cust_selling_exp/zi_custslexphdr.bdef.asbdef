authorization dependent by _Head
//etag master <field_name>
{
  field ( readonly : update, numbering : managed) Item;
  field (readonly) Id;
  update;
  delete;
  //determination updateitem on modify {field Datefrom;}

  association _Head{with draft;}
  determination itemdetails on save {create;}
