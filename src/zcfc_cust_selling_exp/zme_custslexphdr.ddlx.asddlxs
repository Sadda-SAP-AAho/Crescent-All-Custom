    @UI.fieldGroup: [{position: 15,qualifier: 'GeneralData1', importance: #HIGH}]
    @Consumption.valueHelpDefinition: [{ entity:{  element : 'Expcode', name: 'ZCDS_SELEXP_F4'},
    distinctValues: true,
    useForValidation: true,
    additionalBinding: [{ localElement: 'Expname', element: 'Expname',usage: #RESULT}]}]
    Expcode;
    
    @UI.lineItem: [{position: 20}]
    @UI.identification: [{position: 20}]
