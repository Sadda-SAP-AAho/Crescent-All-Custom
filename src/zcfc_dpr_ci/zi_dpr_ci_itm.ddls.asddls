@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'DPR CI ITEM'
@Metadata.ignorePropagatedAnnotations: true
@Metadata.allowExtensions: true
define view entity ZI_DPR_CI_ITM
  as select from zdt_dpr_ci_itm as a
  association to parent ZI_DPR_CI_HEAD as _head on  $projection.Kostl = _head.Kostl
                                                and $projection.Plant = _head.plant
{
  key plant         as Plant,
  key kostl         as Kostl,
  key kostl1        as Kostl1,
  key indate        as Indate,
  key mtdytd        as Mtdytd,
      vdate         as Vdate,
      prodplanqty   as Prodplanqty,
      totalpoured   as Totalpoured,
      mcloss        as Mcloss,
      totalcast     as Totalcast,
      pendcast      as Pendcast,
      stdgoodcast   as Stdgoodcast,
      actgoodcast   as Actgoodcast,
      totgoodmould  as Totgoodmould,
      totbadmould   as Totbadmould,
      bunchwt       as Bunchwt,
      bunchwtfar    as Bunchwtfar,
      rejwt         as Rejwt,
      seclinerej    as Seclinerej,
      rejper        as Rejper,
      finalrejper   as Finalrejper,
      rejlossval    as Rejlossval,
      excesswt      as Excesswt,
      packwt        as Packwt,
      despwt        as Despwt,
      ontimdespqty  as Ontimdespqty,
      ontimdespwt   as Ontimdespwt,
      chargoprn     as Chargoprn,
      spillage      as Spillage,
      stdyield      as Stdyield,
      stdyieldfar   as Stdyieldfar,
      yield         as Yield,
      yieldfar      as Yieldfar,
      stdlmcost     as Stdlmcost,
      lmcost        as Lmcost,
      stdlmcicost   as Stdlmcicost,
      lmcostci      as Lmcostci,
      fgstock       as Fgstock,
      sfgstock      as Sfgstock,
      rmstock       as Rmstock,
      lmstock       as Lmstock,
      caststock     as Caststock,
      macstock      as Macstock,
      grindstock    as Grindstock,
      paintstock    as Paintstock,
      noofcompl     as Noofcompl,
      complamt      as Complamt,
      stcoststdgi   as Stcoststdgi,
      stcostactexp  as Stcostactexp,
      stcostmoustd  as Stcostmoustd,
      stcostmouact  as Stcostmouact,
      stcostmeltstd as Stcostmeltstd,
      stcostmeltact as Stcostmeltact,
      stcostothstd  as Stcostothstd,
      stcostothacc  as Stcostothacc,
      trtmntcoststd as Trtmntcoststd,
      trtmntcostacc as Trtmntcostacc,
      powercoststd  as Powercoststd,
      powercostact  as Powercostact,
      stdpowerunit  as Stdpowerunit,
      actpowunitaux as Actpowunitaux,
      actpoeunitfur as Actpoeunitfur,
      fixedcostloss as Fixedcostloss,
      stdlabexp     as Stdlabexp,
      actlabexp     as Actlabexp,
      productivity  as Productivity,
      otif          as Otif,
      _head
}
