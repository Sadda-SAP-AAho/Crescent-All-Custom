@Metadata.layer: #CORE

@UI: { headerInfo: {
typeName: 'Service Invoice',
typeNamePlural: 'Service Invoices',
title: { type: #STANDARD, value: 'InvoiceReference' }
}}

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'InvoiceReference', direction: #ASC } ],
                          visualizations: [{type: #AS_LINEITEM}]
                           }]
                          }
annotate entity ZC_SERVICE_INV_HEAD with

{
  @UI.facet:
     [{ id: 'GeneralData', isSummary: true, label: 'Service Invoice', type: #COLLECTION },
      { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 1, label: 'Section 1', id: 'GeneralData1' },
       {
     id: 'Generalitem',
     label: 'Service Invoice Item',
     type: #LINEITEM_REFERENCE,
     targetElement: '_Item',
     position:  2
     }
     ]
  @Search.defaultSearchElement: true
  @UI: { lineItem: [{ position: 30 }],
  identification: [{ position: 30 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 30, importance: #HIGH }] }
  InvoiceNo; 
