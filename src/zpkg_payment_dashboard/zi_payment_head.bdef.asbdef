managed implementation in class zbp_i_payment_head unique;
strict ( 1 );
with draft;
define behavior for ZI_PAYMENT_HEAD //alias <alias_name>
with unmanaged save
//persistent table zdt_payment_head
draft table zdr_payment_head
lock master
total etag PostingDate
authorization master ( instance )

//etag master <field_name>
{
  //create;
  update;
//  delete;

  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  field ( readonly ) Accountingdoc, Fiscalyear, Companycode, PaymentMethod,PaymentRunID,DocumentDate, ValueDate,
  PostingDate,Supplier,SupplierName,AmountInCompanyCodeCurrency,CompanyCodeCurrency,HouseBank,HouseBankAccount,
  BankAccountNumber,PayeeBankAccount,PayeeBankKey,apprlevel,Appr1comment,Appr2comment,Status,
  Criticality,Senton,Sentat,Sentby,Utr,Message,Messagecode,Approved,Rejected,Inprocess,Appr1,Appr2,
  Appr3,Reject1,Reject2,Reject3, Filename, Counter;
  action ( features : instance ) APPROVE1 result [1] $self;
//  action ( features : instance ) APPROVE2 result [1] $self;
//  action ( features : instance ) APPROVE3 result [1] $self;
  action ( features : instance ) Reject1 result [1] $self;
    action ( features : instance ) Delete1 result [1] $self;
    action ( features : instance ) senthsbc result [1] $self;
//  action ( features : instance ) Reject2 result [1] $self;
//  action ( features : instance ) Reject3 result [1] $self;
  association _item1 { create; }
  association _item { create; }
    mapping for ZI_PAYMENT_HEAD
    {
      PaymentRunID = PaymentRunID;
      DocumentDate = DocumentDate;
      PostingDate = PostingDate;
      ValueDate   = ValueDate;
      Supplier = Supplier;
      AmountInCompanyCodeCurrency = AmountInCompanyCodeCurrency;
      CompanyCodeCurrency = CompanyCodeCurrency;
      PaymentMethod = PaymentMethod;
      HouseBank = HouseBank;
      HouseBankAccount = HouseBankAccount;
      BankAccountNumber = BankAccountNumber;
      PayeeBankAccount = PayeeBankAccount;
      PayeeBankKey = PayeeBankKey;
      apprlevel = apprlevel;
      Appr1comment = Appr1comment;
      Appr2comment = Appr2comment;
      Status = Status;
      Criticality = Criticality;
      Senton = Senton;
      Sentat = Sentat;
      Sentby = Sentby;
      Utr = Utr;
      Message = Message;
      Messagecode = Messagecode;
      Approved = Approved;
      Rejected = Rejected;
      Inprocess = Inprocess;
      Appr1 = Appr1;
      Appr2 = Appr2;
      Appr3 = Appr3;
      Senthsbc = Senthsbc;
      Reject1 = Reject1;
      Reject2 = Reject2;
      Reject3 = Reject3;
      Filename = Filename;
      Counter = Counter;
      delete_ind = delete_ind;

    }
}

