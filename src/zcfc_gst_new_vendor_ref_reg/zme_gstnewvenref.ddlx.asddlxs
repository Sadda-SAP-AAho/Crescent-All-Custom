@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{
    sortOrder: [{ by: 'Fisyear', direction: #DESC },
                { by: 'Jeno', direction: #DESC }],
    visualizations: [{ type: #AS_LINEITEM }],
    text: 'GST New Vendor Reference No-Register'
  }]
}

@UI: {
  headerInfo: {
    title: {
      type: #STANDARD,
      label: 'GST New Vendor Reference No-Register',
      value: 'Jeno'
    }
  }
}

annotate entity ZC_GSTNEWVENREF with
{
  @UI.facet:
  [
  { id: 'GeneralData',
    isSummary: true,
    label: 'GST Information Dashboard',
    type: #COLLECTION },

  { type: #FIELDGROUP_REFERENCE,
    targetQualifier: 'GeneralData1',
    parentId: 'GeneralData',
    position: 10,
    label: '',
    id: 'GeneralData1' }
  ]

  @UI.hidden: true
  Id;

  @UI.lineItem: [{ position: 5 }]
  @UI.identification: [{ position: 5 }]
  @UI.fieldGroup: [{ qualifier: 'GeneralData1', position: 5 }]
  @UI.selectionField: [{ position: 5 }]
  Fisyear;

  @UI.lineItem: [{position: 10}]
  @UI.identification: [{position: 10}]
  @UI.fieldGroup: [{position: 10,qualifier: 'GeneralData1', importance: #HIGH}]
  @Consumption.valueHelpDefinition: [{ entity:{  element : 'Jeno', name: 'ZCDS_JE_DETAILS_F4'},
  distinctValues: true,
  useForValidation: true,
  additionalBinding: [{ localElement: 'Jedate', element: 'Jedate',usage: #RESULT},
                      { localElement: 'Supplcode', element: 'Supplcode',usage: #RESULT},
                      { localElement: 'Jerefno', element: 'Jerefno',usage: #RESULT}]}]
  Jeno;

  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup: [{ qualifier: 'GeneralData1', position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  Jedate;

  @UI.lineItem: [{ position: 25 }]
  @UI.identification: [{ position: 25 }]
  @UI.fieldGroup: [{ qualifier: 'GeneralData1', position: 25 }]
  @UI.selectionField: [{ position: 25 }]
  Supplcode;

  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup: [{ qualifier: 'GeneralData1', position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  Jerefno;

  @UI.lineItem: [{ position: 35 }]
  @UI.identification: [{ position: 35 }]
  @UI.fieldGroup: [{ qualifier: 'GeneralData1', position: 35 }]
  @UI.selectionField: [{ position: 35 }]
  Newvendrefno;

}