@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{
    sortOrder: [ { by: 'Plant', direction: #ASC },
                 { by: 'HeadMatlCode', direction: #ASC } ],
    visualizations: [{ type: #AS_LINEITEM }],
    text: 'BOM Calculation Check Report' }],

  headerInfo: { typeName: 'BOM Calculation Check Report',
                typeNamePlural: 'BOM Calculation Check Reports',
                title: { type: #STANDARD,
                         label: 'BOM Calculation Check Report',
                         value: 'HeadMatlCode'
    }
  }
}

annotate entity ZC_BOMCALCHKRPT with
{

  @UI.facet:
  [{id: 'GeneralData', isSummary: true, label: 'BOM Calculation Check Report', type: #COLLECTION, position: 5},
  { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 10, label: '', id: 'GeneralData1' }]

  
  @Consumption.valueHelpDefinition: [{
  entity: {
    name    : 'ZCDS_PLANT_VALUE_HELP',
    element : 'Plant'
  }
  }]
  
  @UI: {
    lineItem: [{ position: 5 }],
    identification: [{ position: 5 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 5, importance: #HIGH }]
  }
  @UI.selectionField: [{ position: 5 }]
  Plant;

  @Consumption.valueHelpDefinition: [{
  entity: {
    name    : 'ZCDS_PRODUCTGRP',
    element : 'ProductGroup'
  }
  }]
  
  @UI: {
    lineItem: [{ position: 10 }],
    identification: [{ position: 10 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }]
  }
  @UI.selectionField: [{ position: 10 }]
  productgroup;

  @Consumption.valueHelpDefinition: [{
  entity: {
    name    : 'ZCDS_PRODUCTPLANT',
    element : 'Product'
  },
  additionalBinding: [
    {
      localElement : 'Plant',
      element      : 'Plant'
    },
    {
      localElement : 'ProductGroup',
      element      : 'ProductGroup'
    }
  ]
  }]
  
  @UI: {
    lineItem: [{ position: 20 }],
    identification: [{ position: 20 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 20, importance: #HIGH }]
  }
  @UI.selectionField: [{ position: 20 }]
  HeadMatlCode;

  @UI: {
    lineItem: [{ position: 30 }],
    identification: [{ position: 30 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 30, importance: #HIGH }]
  }
  HeadMatlName;

  @UI: {
    lineItem: [{ position: 40 }],
    identification: [{ position: 40 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 40, importance: #HIGH }]
  }
  HeaderQty;

  @UI: {
    lineItem: [{ position: 50 }],
    identification: [{ position: 50 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 50, importance: #HIGH }]
  }
  sqmtr;

  @UI: {
    lineItem: [{ position: 60 }],
    identification: [{ position: 60 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 60, importance: #HIGH }]
  }
  ComponentCode;

  @UI: {
    lineItem: [{ position: 70 }],
    identification: [{ position: 70 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 70, importance: #HIGH }]
  }
  ComponentName;
  
  @UI: {
    lineItem: [{ position: 80 }],
    identification: [{ position: 80 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 80, importance: #HIGH }]
  }
  CompGrpCode;
  
  @UI: {
    lineItem: [{ position: 90 }],
    identification: [{ position: 90 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 90, importance: #HIGH }]
  }
  CompGrpName;

  @UI: {
    lineItem: [{ position: 100 }],
    identification: [{ position: 100 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 100, importance: #HIGH }]
  }
  Micron;

  @UI: {
    lineItem: [{ position: 110 }],
    identification: [{ position: 110 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 110, importance: #HIGH }]
  }
  SubMicron;

  @UI: {
    lineItem: [{ position: 120 }],
    identification: [{ position: 120 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 120, importance: #HIGH }]
  }
  StdQty;

  @UI: {
    lineItem: [{ position: 130 }],
    identification: [{ position: 130 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 130, importance: #HIGH }]
  }
  BOMQtyCal;

  @UI: {
    lineItem: [{ position: 140 }],
    identification: [{ position: 140 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 140, importance: #HIGH }]
  }
  BOMQtySAP;

  @UI: {
    lineItem: [{ position: 150 }],
    identification: [{ position: 150 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 150, importance: #HIGH }]
  }
  Difference;

}