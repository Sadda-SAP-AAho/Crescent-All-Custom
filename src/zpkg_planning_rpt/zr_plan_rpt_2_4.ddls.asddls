@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'CDS for Planning Rpt 2_4'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType:{
    serviceQuality: #X,
    sizeCategory: #S,
    dataClass: #MIXED
}
define view entity ZR_PLAN_RPT_2_4
  as select distinct from ZR_PLAN_RPT_2_1  as a
    inner join            ZR_PLAN_RPT_2_3  as b on  a.plant     = b.plant
    //                                      and a.hedmaterial = b.hedmaterial
                                                and a.component = b.component
  //  association [0..*] to ZR_PLAN_RPT_2_3                  as b                          on  $projection.Product = _Text.Product
    left outer join       zdt_pp_matinffld as c on a.component = c.product
{
  key a.plant,
      //  key a.hedmaterial,
  key a.component,
      a.ProductGroup,
      a.ProductDescription,
      a.WeightUnit,
      @Semantics.quantity.unitOfMeasure: 'WeightUnit'
      a.NetWeight,
      a.ProfitCenter,
      a.ProfitCenterLongName,
      a.cuscode,
      c.subcode,
      a.qtyperbox,
      a.prodcapcday,
      a.boxsize,
      a.typemould,
      a.OpenContQty,
      @Semantics.quantity.unitOfMeasure: 'WeightUnit'
      a.OpenContQtyWt,
      a.OpenSoQty,
      @Semantics.quantity.unitOfMeasure: 'WeightUnit'
      a.OpenSoQtyWt,
      a.castonhand,
      a.castonhandWt,
      a.FgLiveQty,
      a.FgLivewt,
      a.FgdeadQty,
      a.FgdeadWt,
      a.stockZ028,
      a.stockZ026,
      a.stockZ027,
      a.stockZ045,
      a.stockZ025,
      a.stockZ024,
      a.SfgOnHand,
      a.SfgOnHandWt,
      b.SfgLiveQty,
      b.SfgLiveWt,
      b.SfgdeadQty,
      b.SfgdeadWt,
      b.Totalstockqty,
      b.TotalstockWt,
      a.OpenSoQty7,
      a.OpenSoQty7Wt,
      a.OpenSoQty8,
      a.OpenSoQty8Wt,
      a.OpenSoQty16,
      a.OpenSoQty16Wt,
      a.OpenSoQty23,
      a.OpenSoQty23Wt,
      a.OpenSoQty31,
      a.OpenSoQty31Wt,
      a.OpenSoQty39,
      a.OpenSoQty39Wt,
      a.OpenSoQty47,
      a.OpenSoQty47Wt,
      a.OpenSoQty55,
      a.OpenSoQty55Wt,
      a.OpenSoQty63,
      a.OpenSoQty63Wt,
      a.OpenSoQty71,
      a.OpenSoQty71Wt,
      a.OpenSoQty366,
      a.OpenSoQty366Wt,
      b.OpenSoQtySwt7,
      b.opensoqtysnl7,
      b.OpenSoQtySrd7,
      b.OpenSoQtySwt8,
      b.opensoqtysnl8,
      b.OpenSoQtySrd8,
      b.OpenSoQtySwt16,
      b.opensoqtysnl16,
      b.OpenSoQtySrd16,
      b.OpenSoQtySwt23,
      b.opensoqtysnl23,
      b.OpenSoQtySrd23,
      b.OpenSoQtySwt31,
      b.opensoqtysnl31,
      b.OpenSoQtySrd31,
      b.OpenSoQtySwt39,
      b.opensoqtysnl39,
      b.OpenSoQtySrd39,
      b.OpenSoQtySwt47,
      b.opensoqtysnl47,
      b.OpenSoQtySrd47,
      b.OpenSoQtySwt55,
      b.opensoqtysnl55,
      b.OpenSoQtySrd55,
      b.OpenSoQtySwt63,
      b.opensoqtysnl63,
      b.OpenSoQtySrd63,
      b.OpenSoQtySwt71,
      b.opensoqtysnl71,
      b.OpenSoQtySrd71,
      b.OpenSoQtySwt366,
