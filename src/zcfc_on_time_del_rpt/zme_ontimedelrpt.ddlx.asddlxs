@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{
    sortOrder: [
      { by: 'sodate', direction: #ASC },
      { by: 'SalesOrder', direction: #ASC },
      { by: 'SalesOrderItem', direction: #ASC }
    ],
    visualizations: [{ type: #AS_LINEITEM }],
    text: 'On Time Delivery Report'
  }],

  headerInfo: {
    typeName: 'On Time Delivery Report',
    typeNamePlural: 'On Time Delivery Reports',
    title: {
      type: #STANDARD,
      label: 'On Time Delivery Report',
      value: 'SalesOrder'
    }
  }
}

annotate entity ZC_ONTIMEDELRPT with
{
  @UI.facet: [
    {
      id: 'GeneralData',
      isSummary: true,
      label: 'On Time Delivery Details',
      type: #COLLECTION,
