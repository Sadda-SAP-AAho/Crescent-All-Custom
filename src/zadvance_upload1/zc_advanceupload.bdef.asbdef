projection;
strict ( 2 );
use draft;

define behavior for zc_advanceupload //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for zc_advanceuploaditm //alias <alias_name>
{
  use update;
  use delete;

  use association _head;
}