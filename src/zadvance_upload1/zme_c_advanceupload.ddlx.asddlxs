@Metadata.layer: #CORE

@UI: { headerInfo: {
typeName: 'Advance Payment Uploader',
typeNamePlural: 'Advance Payment Uploader',
title: { type: #STANDARD, value: 'Id' },
         imageUrl: 'Attachment',
         description: { type: #STANDARD, value: 'filename' } },
         presentationVariant: [{
         sortOrder: [{ by: 'Id', direction: #ASC }],
         visualizations: [{type: #AS_LINEITEM}] }] }

annotate entity zc_advanceupload with
{
  @UI.facet:
  [

  {
  id: 'GeneralData',
  isSummary: true,
  label: 'Header Data',
  type: #COLLECTION,
  position:  1
  },

  {
  type: #FIELDGROUP_REFERENCE,
  targetQualifier: 'GeneralData1',
  parentId: 'GeneralData',
  label: 'Basic Data',
  position: 10,
  id: 'GeneralData1'
  },

  {
  type: #FIELDGROUP_REFERENCE,
  targetQualifier: 'GeneralData2',
  parentId: 'GeneralData',
  position: 30,
  label: 'File Details',
  id: 'GeneralData2'
  },

  {
  id: 'Item1',
  label: 'Item Lines',
  type: #LINEITEM_REFERENCE,
  targetElement: '_item',
  position : 2
  }
  ]

  @UI.hidden: true
  Id;

  @UI: { lineItem:       [ { position: 20, importance: #HIGH , label: 'Processing Status', criticality: 'CriticalityStatus'} ] ,
       identification: [ { position: 20 , label: 'Processing Status' } ] ,
       fieldGroup: [{ qualifier: 'GeneralData1', label: 'Processing Status', position: 20, importance: #HIGH, criticality: 'CriticalityStatus' }] }
  FileStatus;

  @UI: { lineItem:       [ { position: 35, importance: #HIGH , label: 'Posted?'} ] ,
        identification: [ { position: 35 , label: 'Posted?' } ] ,
        fieldGroup: [{ qualifier: 'GeneralData1', label: 'Posted?', position: 35, importance: #HIGH }] }
  Post;

  @UI: { fieldGroup: [{ qualifier: 'GeneralData2', position: 10, label: 'Attachment', importance: #HIGH }] }
  Attachment;

  @UI: { lineItem:       [ { position: 40, importance: #HIGH , label: 'File Name'} ] ,
         identification: [ { position: 40 , label: 'File Name' } ]  }
  Filename;

  //  @UI: { lineItem:       [ { position: 50, importance: #HIGH , label: 'Created At'} ] ,
  //         identification: [ { position: 50 , label: 'Created At' } ],
  //         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Created At', position: 50, importance: #HIGH }]}
  @UI.hidden: true
  LocalCreatedAt;

//  @UI: { lineItem:       [ { position: 60, importance: #HIGH , label: 'Created By'} ] ,
//         identification: [ { position: 60 , label: 'Created By' } ],
//         fieldGroup: [{ qualifier: 'GeneralData1', label: 'Created By', position: 60, importance: #HIGH }]  }
         @UI.hidden: true
  LocalCreatedBy;

  @UI.hidden: true
  Mimetype;

  @UI.hidden: true
  LocalLastChangedBy;
}