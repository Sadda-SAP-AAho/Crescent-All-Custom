managed with additional save implementation in class ZBP_I_IPPODOCUMENTTYPE_S unique;
strict;
with draft;
define behavior for ZI_IpPoDocumentType_S alias IpPoDocumentTypeAll
draft table zdt_ip_doc__d_s
with unmanaged save
lock master total etag LastChangedAtMax
authorization master ( global )

{
  field ( readonly )
  SingletonID;

    field ( features : instance )
     TransportRequestID;

  field ( notrigger )
  SingletonID,
  LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
    action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _IpPoDocumentType { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

    side effects {
      action SelectCustomizingTransptReq affects $self;
    }
}

define behavior for ZI_IpPoDocumentType alias IpPoDocumentType ##UNMAPPED_FIELD
persistent table zdt_ip_doc_tmg
