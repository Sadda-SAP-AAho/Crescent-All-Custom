define behavior for ZI_CONFPOST_ORD //alias <alias_name>
persistent table zdt_confpost_ord
//with unmanaged save
draft table zdr_confpost_ord
lock dependent by _Head
authorization dependent by _Head
//etag master <field_name>
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly : update, numbering : managed ) Ord, Item;
  field ( readonly ) Id, Shpflrno, Matnr, Meins, Prodord, Pendprqty, Docsta, Rej, Plant, Ordersta,
  Refid, RefItem, Reford, Serial, Heatno, Status, Progress, criticality, Total, Balqty, Alpostqty, Uniqueid;
  field ( features : instance ) Postqty;

  determination calqty on modify { field Postqty; }
  validation    checkord on save { create; update; }

  side effects {

  field Postqty affects field Balqty;

  }


  association _Head { with draft; }
  mapping for zi_confpost_ord
    {
      Refid       = Refid;
      Refitem     = Refitem;
      Reford      = Reford;
      Shpflrno    = Shpflrno;
      Matnr       = Matnr;
      Plant       = Plant;
      Meins       = Meins;
      Prodord     = Prodord;
      Postqty     = Postqty;
      Balqty      = Balqty;
      Pendprqty   = Pendprqty;
      Alpostqty   = Alpostqty;
      Rej         = Rej;
      Ordersta    = Ordersta;
      Docsta      = Docsta;
      Serial      = Serial;
      Heatno      = Heatno;
      Status      = Status;
      Progress    = Progress;
      Criticality = Criticality;
      Total       = Total;
      Uniqueid    = Uniqueid;
    }
}
