managed implementation in class zbp_i_confpost_hdr unique;
strict;
with draft;

define behavior for ZI_CONFPOST_HDR //alias <alias_name>
persistent table zdt_confpost_hdr
draft table zdr_confpost_hdr
lock master
total etag Shpflrno
authorization master ( instance )
//etag master <field_name>
{
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
  }

  create;
  update ( features : instance );
  delete ( features : instance );
  field ( readonly : update, numbering : managed ) Id;
  field ( mandatory : create, readonly : update ) Shpflrno;
  field ( readonly ) Dept, Opr, Cont, Deptname, Oprname, Contname, Keyid, Creby, Creon, Plant, Plantid, Shpflrdt, Refid;
  field ( readonly ) Skilab, Sskilab, Uskilab, Status, Progress, Criticality, Total, Stat, Arpacharg, Rhinocharg, Handmochrg,
                     Excwtadj, Lostfmchrg, Uniqueid;
  field ( features : instance ) Docudt;

  determination getdet on modify { field Shpflrno; }
  determination updata on save { create; }
  validation checkdet on save { create; }


  action ( features : instance ) Getord result [1] $self;
  action ( features : instance ) Post result [1] $self;
  action ( features : instance ) Gr result [1] $self;
  action ( features : instance ) Gi result [1] $self;
  action ( features : instance ) Scrap result [1] $self;

  side effects
  {
    action Getord affects entity _Ord, entity _Item;
    action Post affects entity _Ord, entity _Item;
    action Gr affects entity _Ord, entity _Item;
    action Gi affects entity _Ord, entity _Item;
    action Scrap affects entity _Ord, entity _Item;
  }

  association _Item { create ( features : instance ); with draft; }
  association _Ord { create ( features : instance ); with draft; }
  association _Log { create ( features : instance ); with draft; }
  mapping for zi_confpost_hdr
    {
      Refid       = Refid;
      Shpflrno    = Shpflrno;
      Keyid       = Keyid;
      Dept        = Dept;
      Deptname    = DeptName;
      Opr         = Opr;
      Oprname     = Oprname;
      Cont        = Cont;
      Contname    = Contname;
      Creby       = Creby;
      Creon       = Creon;
      Skilab      = Skilab;
      Sskilab     = Sskilab;
      Uskilab     = Uskilab;
      Plant       = Plant;
      Plantid     = Plantid;
      Shpflrdt    = Shpflrdt;
      Getord      = Getord;
      Post        = Post;
      Gr          = Gr;
      Gi          = Gi;
      Status      = Status;
      Progress    = Progress;
      Criticality = Criticality;
      Total       = Total;
      Stat        = Stat;
      Arpacharg   = Arpacharg;
      Rhinocharg  = Rhinocharg;
      Handmochrg  = Handmochrg;
      Lostfmchrg  = Lostfmchrg;
      Excwtadj    = Excwtadj;
      Docudt      = Docudt;
      Uniqueid    = Uniqueid;
    }
}

