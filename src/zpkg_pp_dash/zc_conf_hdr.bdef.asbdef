projection;
strict;
use draft;
use side effects;

define behavior for ZC_CONF_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action Simu;
  use action Alloc;
  use action Genser;
  use action Scan;

  use association _Item { create; with draft; }
  use association _Ord { create; with draft; }
}

define behavior for ZC_CONF_ITM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}

define behavior for ZC_CONF_ORD //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}