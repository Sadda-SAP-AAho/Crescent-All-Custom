projection;
strict;
use draft;
use side effects;

define behavior for ZC_CONFPOST_HDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action Getord;
  use action Post;
  use action Gr;
  use action Gi;
  use action Scrap;

  use association _Item { create; with draft; }
  use association _Ord { create; with draft; }
  use association _Log { create; with draft; }
}

define behavior for ZC_CONFPOST_ITM //alias <alias_name>
{
  use update;
  //use delete;

  use association _Head { with draft; }
}

define behavior for ZC_CONFPOST_ORD //alias <alias_name>
{
  use update;
  //use delete;

  use association _Head { with draft; }
}


define behavior for ZC_CONFPOST_LOG //alias <alias_name>
{
  use update;
  //use delete;

  use association _Head { with draft; }
}