projection implementation in class zbp_c_labour_book unique;
strict ( 1 );
use draft;
use side effects;

define behavior for ZC_LABOUR_BOOK //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _items { create; with draft; }
}

define behavior for ZC_LABOUR_BOOK_ITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head {with draft;}
}