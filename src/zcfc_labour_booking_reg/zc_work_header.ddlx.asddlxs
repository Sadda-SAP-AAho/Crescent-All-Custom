@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'PlantCode'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'PlantCode'
annotate view ZC_WORK_HEADER with
{
  @UI.facet: [ {
    label: 'General Information', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE
  },
              { 
            id : 'Item',
            purpose : #STANDARD,
            label: 'Work Item Details',
            type: #LINEITEM_REFERENCE,
            position: 20,
            targetElement: '_items'
              } ]
  @UI.identification: [ {
    position: 10 
  } ]
  @UI.lineItem: [ {
    position: 10 
  } ]
  @UI.selectionField: [ {
    position: 10 
  } ]
  @Consumption.valueHelpDefinition: [{ entity : { name : 'ZVH_PLANT', 
                                                  element : 'PLANT_CODE' },
  additionalBinding: [{ localElement: 'PlantName', element: 'PLANT_NAME',
  usage: #FILTER_AND_RESULT }] }]
  PlantCode;
  
  @UI.identification: [ {
    position: 30 
  } ]
  @UI.lineItem: [ {
    position: 30 
  } ]
  @UI.selectionField: [ {
    position: 30 
  } ]
  WorkCode;
  
  @UI.identification: [ {
    position: 20 
  } ]
  @UI.lineItem: [ {
    position: 20 
  } ]
  
  PlantName;
  
  @UI.identification: [ {
    position: 40 
  } ]
  @UI.lineItem: [ {
    position: 40 
  } ]
  
  WorkName;
  
  @UI.hidden: true
  BeginDate;
  
  @UI.hidden: true
  EndDate;
  
  @UI.hidden: true
  CreatedBy;
  
  @UI.hidden: true
  CreatedAt;
  
  @UI.hidden: true
  LastChangedBy;
  
  @UI.hidden: true
  LastChangedAt;
  
  @UI.hidden: true
  Localcreatedby;
  
  @UI.hidden: true
  Locallastchangedby;
  
  @UI.hidden: true
  Localcreatedat;
  
  @UI.hidden: true
  Locallastchangedat;
  
  @UI.hidden: true
  Lastchangeat;
}